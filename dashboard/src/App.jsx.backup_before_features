                                  </div>
                                  <div style={{ textAlign: "right" }}>
                                    <div style={{ fontSize: "10px", color: "#94a3b8", marginBottom: "3px" }}>Risk Level</div>
                                    <div style={{ fontSize: "13px", fontWeight: "800", color: riskCol, padding: "3px 10px", borderRadius: "6px", background: riskCol + "20" }}>{riskLevel}</div>
