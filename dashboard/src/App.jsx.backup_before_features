                                <div>
                                  <div style={{ fontSize: "10px", color: t.accent, fontWeight: "700", textTransform: "uppercase", letterSpacing: "0.1em", marginBottom: "4px" }}>🧠 AI SITE INTELLIGENCE</div>
                                  <div style={{ fontSize: "15px", fontWeight: "700", color: "#f8fafc" }}>{latest.stage_detected}</div>
