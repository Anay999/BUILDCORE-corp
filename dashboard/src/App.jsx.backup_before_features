                                  ) : (
                                    <div style={{ padding: "14px 16px", display: "flex", flexDirection: "column", gap: "12px" }}>
                                      {myUpdates.map((update, idx) => {
                                        let attachments = [];
                                        if (update.attachments) { try { attachments = JSON.parse(update.attachments); } catch { attachments = []; } }
                                        else if (update.image) { attachments = [update.image]; }
                                        const uc = avatarColor(user.id);
                                        return (
                                          <div key={update.id} style={{ background: t.bg, border: `1px solid ${t.cardBorder}`, borderRadius: "10px", overflow: "hidden", borderLeft: `3px solid ${uc}` }}>
                                            {/* update header */}
                                            <div style={{ padding: "9px 13px", borderBottom: `1px solid ${t.divider}`, display: "flex", alignItems: "center", justifyContent: "space-between" }}>
                                              <div style={{ display: "flex", alignItems: "center", gap: "8px" }}>
                                                <div style={{ width: "20px", height: "20px", borderRadius: "50%", background: uc + "20", border: `1px solid ${uc}40`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: "9px", fontWeight: "800", color: uc }}>{myUpdates.length - idx}</div>
                                                <span style={{ fontSize: "10px", color: t.muted }}>{fmtDateTime(update.created_at)}</span>
                                              </div>
                                              {editingProgressId !== update.id && (
                                                <button onClick={() => { setEditingProgressId(update.id); setEditProgressNote(update.note); }}
                                                  style={{ background: "transparent", border: "none", color: t.muted, cursor: "pointer", padding: "3px", display: "flex", alignItems: "center", opacity: 0.5 }}
                                                  onMouseEnter={e => e.currentTarget.style.opacity = "1"}
                                                  onMouseLeave={e => e.currentTarget.style.opacity = "0.5"}>
                                                  <Ic.Edit />
                                                </button>
                                              )}
                                            </div>
                                            {/* attachments */}
                                            {attachments.length > 0 && editingProgressId !== update.id && (
                                              <div style={{ display: "grid", gridTemplateColumns: attachments.length === 1 ? "1fr" : "repeat(2, 1fr)", gap: "2px" }}>
                                                {attachments.map((fname, ai) => {
                                                  const ext = fname.split(".").pop().toLowerCase();
                                                  const isImg = ["jpg","jpeg","png","gif","webp"].includes(ext);
                                                  const isVideo = ["mp4","mov","webm","avi"].includes(ext);
                                                  if (isImg) return <img key={ai} src={`http://localhost:5000/uploads/${fname}`} alt="" onClick={() => { setLightboxSrc(`http://localhost:5000/uploads/${fname}`); setLightboxZoom(1); }} style={{ width: "100%", height: attachments.length === 1 ? "160px" : "100px", objectFit: "cover", display: "block", cursor: "zoom-in" }} onError={e => e.target.style.display = "none"} />;
                                                  if (isVideo) return <video key={ai} src={`http://localhost:5000/uploads/${fname}`} controls style={{ width: "100%", height: attachments.length === 1 ? "160px" : "100px", objectFit: "cover", display: "block", background: "#000" }} />;
                                                  return <a key={ai} href={`http://localhost:5000/uploads/${fname}`} target="_blank" rel="noreferrer" style={{ display: "flex", alignItems: "center", gap: "8px", padding: "8px 12px", background: t.hover, textDecoration: "none", borderTop: `1px solid ${t.divider}` }}><Ic.FileDoc /><span style={{ fontSize: "11px", color: t.text }}>{fname}</span></a>;
                                                })}
                                              </div>
                                            )}
                                            {/* note / edit */}
                                            {editingProgressId === update.id ? (
                                              <div style={{ padding: "12px 13px", display: "flex", flexDirection: "column", gap: "8px" }}>
                                                <textarea value={editProgressNote} onChange={e => setEditProgressNote(e.target.value)} style={{ ...inputSt, minHeight: "70px", resize: "vertical", lineHeight: "1.6", fontSize: "12px" }} />
                                                <div style={{ display: "flex", gap: "7px" }}>
                                                  <button onClick={() => updateProgress(update.id, selectedProject.id)} style={{ flex: 1, padding: "7px", background: t.accent, border: "none", borderRadius: "7px", color: "#0f172a", fontWeight: "700", fontSize: "11px", cursor: "pointer" }}>Save</button>
                                                  <button onClick={() => { setEditingProgressId(null); setEditProgressNote(""); }} style={{ flex: 1, padding: "7px", background: "transparent", border: `1px solid ${t.divider}`, borderRadius: "7px", color: t.muted, fontWeight: "600", fontSize: "11px", cursor: "pointer" }}>Cancel</button>
                                                </div>
                                              </div>
                                            ) : (
                                              <div style={{ padding: "10px 13px" }}>
                                                <p style={{ margin: 0, fontSize: "12px", color: t.text, lineHeight: "1.65" }}>{update.note}</p>
                                              </div>
                                            )}
                                          </div>
                                        );
                                      })}
                                    </div>
                                  )}
                                </div>
                              );
                            })()}

                            {/* TEAM MEMBER CARDS — boss only, click = go to their page */}
                            {can(user.role, "canManageTeam") && teamMembers.length > 0 && (
                              <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", overflow: "hidden" }}>
                                <div style={{ padding: "11px 18px", borderBottom: `1px solid ${t.divider}` }}>
                                  <span style={{ fontSize: "11px", fontWeight: "700", color: t.muted, textTransform: "uppercase", letterSpacing: "0.07em" }}>Team Members</span>
                                </div>
                                <div style={{ padding: "14px 16px", display: "flex", flexWrap: "wrap", gap: "10px" }}>
                                  {teamMembers.map(member => {
                                    const mc  = avatarColor(member.id);
                                    const pic = member.profile_picture ? `http://localhost:5000/uploads/${member.profile_picture}` : null;
                                    const cnt = allUpdates.filter(u => u.user_id === member.id).length;
                                    return (
                                      <button key={member.id} onClick={() => setSelectedProgressEmployee(member.id)}
                                        style={{ display: "flex", flexDirection: "column", alignItems: "center", gap: "7px", padding: "12px 14px", background: t.hover, border: `1.5px solid ${t.cardBorder}`, borderRadius: "12px", cursor: "pointer", transition: "all 0.15s", minWidth: "76px" }}
                                        onMouseEnter={e => { e.currentTarget.style.borderColor = mc; e.currentTarget.style.background = mc + "12"; }}
                                        onMouseLeave={e => { e.currentTarget.style.borderColor = t.cardBorder; e.currentTarget.style.background = t.hover; }}>
                                        <div style={{ width: "40px", height: "40px", borderRadius: "50%", overflow: "hidden", border: `2px solid ${mc}50`, flexShrink: 0 }}>
                                          {pic
                                            ? <img src={pic} style={{ width: "100%", height: "100%", objectFit: "cover" }} alt="" />
                                            : <div style={{ width: "100%", height: "100%", background: mc + "20", display: "flex", alignItems: "center", justifyContent: "center", fontSize: "15px", fontWeight: "700", color: mc }}>{(member.first_name || member.name || "?").charAt(0).toUpperCase()}</div>}
                                        </div>
                                        <div style={{ fontSize: "11px", fontWeight: "600", color: t.text, textAlign: "center", maxWidth: "74px", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{member.first_name || member.name}</div>
                                        <div style={{ fontSize: "9px", fontWeight: "700", color: t.muted, background: t.card, borderRadius: "99px", padding: "2px 8px" }}>{cnt} update{cnt !== 1 ? "s" : ""}</div>
                                      </button>
                                    );
                                  })}
                                </div>
                              </div>
                            )}
                        </div>
                      );
                    })()}

                    {/* ── TASKS TAB ── */}
                    {projectTab === "tasks" && tasksLoading && (
                      <div style={{ display: "flex", flexDirection: "column", gap: "10px", padding: "4px 0" }}>
                        {Array.from({ length: 4 }).map((_, i) => <SkeletonRow key={i} t={t} />)}
                      </div>
                    )}
                    {projectTab === "tasks" && !tasksLoading && (() => {
                      const projectTasks = tasks[selectedProject.id] || [];
                      const done = projectTasks.filter(t2 => t2.completed).length;
                      const total = projectTasks.length;
                      const prioMeta = { high: { label: "High", color: "#ef4444" }, medium: { label: "Med", color: "#f59e0b" }, low: { label: "Low", color: "#10b981" } };
                      const getTaskStatus = task => task.status || (task.completed ? "done" : "pending");
                      const kanbanCols = [
                        { id: "pending",     label: "To Do",      color: t.muted,    icon: "○" },
                        { id: "in_progress", label: "In Progress", color: "#f59e0b", icon: "◑" },
                        { id: "done",        label: "Done",        color: "#10b981",  icon: "●" },
                      ];
                      return (
                        <div style={{ display: "flex", flexDirection: "column", gap: "18px" }}>
                          {/* top panel: ring + form */}
                          <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", overflow: "hidden" }}>
                            <div style={{ padding: "13px 18px", borderBottom: `1px solid ${t.divider}`, background: t.accentDim, display: "flex", alignItems: "center", justifyContent: "space-between" }}>
                              <div style={{ fontSize: "11px", fontWeight: "700", color: t.accent, textTransform: "uppercase", letterSpacing: "0.08em" }}>
                                {can(user.role, "canAddTask") ? "Add Task" : "Task Overview"}
                              </div>
                              {/* view toggle */}
                              <div style={{ display: "flex", gap: "4px", background: t.hover, borderRadius: "7px", padding: "3px" }}>
                                {["list", "kanban", "gantt"].map(v => (
                                  <button key={v} onClick={() => setTaskView(v)} style={{ padding: "3px 10px", borderRadius: "5px", border: "none", background: taskView === v ? t.accent : "transparent", color: taskView === v ? "#0f172a" : t.muted, fontSize: "10px", fontWeight: "700", cursor: "pointer", textTransform: "capitalize" }}>{v}</button>
                                ))}
                              </div>
                            </div>
                            <div style={{ padding: "16px 18px", display: "flex", gap: "24px", alignItems: "flex-start" }}>
                              {/* completion ring */}
                              <div style={{ display: "flex", alignItems: "center", gap: "14px", flexShrink: 0, alignSelf: "center" }}>
                                <div style={{ position: "relative", width: "56px", height: "56px", flexShrink: 0 }}>
                                  <svg width="56" height="56" viewBox="0 0 56 56">
                                    <circle cx="28" cy="28" r="22" fill="none" stroke={t.divider} strokeWidth="4"/>
                                    <circle cx="28" cy="28" r="22" fill="none" stroke={t.accent} strokeWidth="4"
                                      strokeDasharray={`${total === 0 ? 0 : (done / total) * 138.2} 138.2`}
                                      strokeLinecap="round" transform="rotate(-90 28 28)" style={{ transition: "stroke-dasharray 0.5s" }}/>
                                  </svg>
                                  <div style={{ position: "absolute", inset: 0, display: "flex", alignItems: "center", justifyContent: "center", fontSize: "12px", fontWeight: "800", color: t.accent }}>{total === 0 ? "—" : `${Math.round((done/total)*100)}%`}</div>
                                </div>
                                <div>
                                  <div style={{ fontSize: "18px", fontWeight: "800", color: t.text, fontFamily: "'Barlow Condensed', sans-serif" }}>{done} / {total}</div>
                                  <div style={{ fontSize: "11px", color: t.muted }}>tasks completed</div>
                                </div>
                              </div>

                              {user.role === "boss" && (
                                <div style={{ flex: 1, display: "flex", flexDirection: "column", gap: "8px" }}>
                                  <input
                                    style={{ ...inputSt, fontSize: "13px" }}
                                    placeholder="Task description…"
                                    value={taskInput}
                                    onChange={e => setTaskInput(e.target.value)}
                                    onKeyDown={e => { if (e.key === "Enter") createTask(selectedProject.id); }}
                                  />
                                  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "6px" }}>
                                    {/* priority */}
                                    <select style={{ ...inputSt, fontSize: "12px", padding: "8px 10px", color: prioMeta[taskPriority]?.color }} value={taskPriority} onChange={e => setTaskPriority(e.target.value)}>
                                      <option value="high">🔴 High</option>
                                      <option value="medium">🟡 Medium</option>
                                      <option value="low">🟢 Low</option>
                                    </select>
                                    {/* due date */}
                                    <input type="date" style={{ ...inputSt, fontSize: "12px", padding: "8px 10px" }} value={taskDueDate} onChange={e => setTaskDueDate(e.target.value)} />
                                  </div>
                                  {/* assignee */}
                                  <select style={{ ...inputSt, fontSize: "12px", padding: "8px 10px" }} value={taskAssignTo} onChange={e => setTaskAssignTo(e.target.value)}>
                                    <option value="">Assign to…</option>
                                    {(selectedProject.assigned_users || []).map(m => (
                                      <option key={m.id} value={m.id}>{m.name}</option>
                                    ))}
                                  </select>
                                  <button onClick={() => createTask(selectedProject.id)} disabled={!taskInput.trim()}
                                    style={{ padding: "10px", background: taskInput.trim() ? t.accent : t.hover, border: "none", borderRadius: "9px", color: taskInput.trim() ? "#0f172a" : t.muted, fontWeight: "700", fontSize: "13px", cursor: taskInput.trim() ? "pointer" : "not-allowed", transition: "all 0.15s" }}>
                                    + Add Task
                                  </button>
                                </div>
                              )}
                            </div>
                          </div>

                          {/* bottom panel: list or kanban */}
                          <div>
                            {taskView === "list" ? (
                              projectTasks.length === 0 ? (
                              <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", padding: "60px 24px", textAlign: "center" }}>
                                <div style={{ fontSize: "40px", marginBottom: "12px" }}>✅</div>
                                <div style={{ fontSize: "15px", fontWeight: "600", color: t.text, marginBottom: "6px" }}>No tasks yet</div>
                                <div style={{ fontSize: "13px", color: t.muted }}>{user.role === "boss" ? "Add the first task using the form above" : "Your manager hasn't added tasks yet"}</div>
                              </div>
                            ) : (
                              <div style={{ display: "flex", flexDirection: "column", gap: "8px" }}>
                                {projectTasks.map(task => {
                                  const checkerUser = task.completed && task.completed_by ? users.find(u => u.id === task.completed_by) : null;
                                  const assignee = task.assigned_to ? users.find(u => u.id === task.assigned_to) : null;
                                  const prio = task.priority || "medium";
                                  const pc = prioMeta[prio]?.color || t.muted;
                                  const overdue = task.due_date && !task.completed && new Date(task.due_date) < new Date();
                                  return (
                                    <div key={task.id} style={{ background: t.card, border: `1px solid ${task.completed ? t.accent + "30" : t.cardBorder}`, borderRadius: "12px", padding: "13px 16px", transition: "all 0.15s" }}>
                                      {/* flex row: checkbox + content + action buttons */}
                                      <div style={{ display: "flex", alignItems: "flex-start", gap: "12px" }}>
                                        {/* checkbox */}
                                        <button onClick={() => toggleTask(task.id, selectedProject.id)}
                                          style={{ width: "20px", height: "20px", borderRadius: "6px", border: `2px solid ${task.completed ? t.accent : t.divider}`, background: task.completed ? t.accent : "transparent", flexShrink: 0, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", marginTop: "1px", transition: "all 0.15s" }}
                                        >
                                          {task.completed && <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#0f172a" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round"><polyline points="20 6 9 17 4 12"/></svg>}
                                        </button>
                                        {/* content */}
                                        <div style={{ flex: 1, minWidth: 0 }}>
                                          <div style={{ display: "flex", alignItems: "center", gap: "7px", flexWrap: "wrap", marginBottom: "4px" }}>
                                            <span style={{ fontSize: "13px", fontWeight: "500", color: t.text, textDecoration: task.completed ? "line-through" : "none", opacity: task.completed ? 0.6 : 1 }}>{task.title}</span>
                                            <span style={{ fontSize: "9px", fontWeight: "700", padding: "1px 6px", borderRadius: "99px", background: pc + "18", color: pc, textTransform: "uppercase", letterSpacing: "0.05em" }}>{prioMeta[prio]?.label}</span>
                                          </div>
                                          <div style={{ display: "flex", gap: "10px", flexWrap: "wrap" }}>
                                            {task.due_date && (
                                              <span style={{ fontSize: "10px", color: overdue ? t.red : t.muted }}>
                                                {overdue ? "⚠️ " : "📅 "}Due {new Date(task.due_date).toLocaleDateString("en-IN", { day: "2-digit", month: "short" })}
                                              </span>
                                            )}
                                            {assignee && <span style={{ fontSize: "10px", color: t.muted }}>👤 {assignee.name}</span>}
                                            {checkerUser && <span style={{ fontSize: "10px", color: t.muted }}>✓ {checkerUser.name}</span>}
                                          </div>
                                        </div>
                                        {/* comment toggle */}
                                        <button onClick={() => {
                                          const newId = expandedTaskId === task.id ? null : task.id;
                                          setExpandedTaskId(newId);
                                          if (newId) { fetchTaskComments(task.id); setCommentInput(""); }
                                        }}
                                          style={{ display: "flex", alignItems: "center", gap: "4px", background: "transparent", border: "none", color: expandedTaskId === task.id ? t.accent : t.muted, cursor: "pointer", padding: "4px", fontSize: "11px", fontWeight: "600", flexShrink: 0 }}>
                                          💬 {(taskComments[task.id] || []).length || ""}
                                        </button>
                                        {user.role === "boss" && (
                                          <button onClick={() => deleteTask(task.id, selectedProject.id)} title="Remove task"
                                            style={{ background: "transparent", border: "none", color: t.muted, cursor: "pointer", padding: "4px", display: "flex", alignItems: "center", flexShrink: 0, opacity: 0.5, transition: "opacity 0.15s", marginTop: "-2px" }}
                                            onMouseEnter={e => e.currentTarget.style.opacity = "1"}
                                            onMouseLeave={e => e.currentTarget.style.opacity = "0.5"}
                                          ><Ic.Trash /></button>
                                        )}
                                      </div>

                                      {/* ── comment thread (inside card, below row) ── */}
                                      {expandedTaskId === task.id && (
                                      <div style={{ marginTop: "10px", paddingTop: "10px", borderTop: `1px solid ${t.divider}` }}>
                                        {/* existing comments */}
                                        <div style={{ display: "flex", flexDirection: "column", gap: "7px", marginBottom: "10px" }}>
                                          {(taskComments[task.id] || []).map(c => {
                                            const cc = avatarColor(c.user_id);
                                            return (
                                              <div key={c.id} style={{ display: "flex", gap: "8px", alignItems: "flex-start" }}>
                                                <div style={{ width: "24px", height: "24px", borderRadius: "6px", background: cc + "20", border: `1px solid ${cc}40`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: "10px", fontWeight: "700", color: cc, flexShrink: 0, overflow: "hidden" }}>
                                                  {c.profile_picture ? <img src={`http://localhost:5000/uploads/${c.profile_picture}`} style={{ width: "100%", height: "100%", objectFit: "cover" }} alt="" /> : c.name?.charAt(0)?.toUpperCase()}
                                                </div>
                                                <div style={{ flex: 1, minWidth: 0 }}>
                                                  <div style={{ fontSize: "10px", color: t.muted, marginBottom: "2px" }}>{c.name} · {fmtDateTime(c.created_at)}</div>
                                                  <div style={{ fontSize: "12px", color: t.text, lineHeight: "1.45", wordBreak: "break-word" }}>{c.content}</div>
                                                </div>
                                                {(c.user_id === user.id || user.role === "boss") && (
                                                  <button onClick={() => deleteTaskComment(c.id, task.id)}
                                                    style={{ background: "transparent", border: "none", color: t.muted, cursor: "pointer", padding: "2px", fontSize: "11px", opacity: 0.4, flexShrink: 0 }}
                                                    onMouseEnter={e => e.currentTarget.style.opacity = "1"}
                                                    onMouseLeave={e => e.currentTarget.style.opacity = "0.4"}>✕</button>
                                                )}
                                              </div>
                                            );
                                          })}
                                          {(taskComments[task.id] || []).length === 0 && (
                                            <div style={{ fontSize: "11px", color: t.muted, fontStyle: "italic" }}>No comments yet</div>
                                          )}
                                        </div>
                                        {/* add comment */}
                                        <div style={{ display: "flex", gap: "7px" }}>
                                          <input style={{ ...inputSt, flex: 1, fontSize: "12px", padding: "7px 11px" }}
                                            placeholder="Add a comment…"
                                            value={commentInput}
                                            onChange={e => setCommentInput(e.target.value)}
                                            onKeyDown={e => { if (e.key === "Enter") addTaskComment(task.id); }}
                                          />
                                          <button onClick={() => addTaskComment(task.id)} disabled={!commentInput.trim()}
                                            style={{ padding: "7px 13px", background: commentInput.trim() ? t.accent : t.hover, border: "none", borderRadius: "8px", color: commentInput.trim() ? "#0f172a" : t.muted, fontWeight: "700", fontSize: "12px", cursor: commentInput.trim() ? "pointer" : "not-allowed" }}>
                                            Post
                                          </button>
                                        </div>
                                      </div>
                                    )}
                                    </div>
                                  );
                                })}
                              </div>
                            )) : (
                              <div style={{ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: "12px", alignItems: "start" }}>
                                {kanbanCols.map(col => {
                                  const colTasks = projectTasks.filter(tk => getTaskStatus(tk) === col.id);
                                  const isDragOver = dragOverCol === col.id;
                                  return (
                                    <div key={col.id}
                                      onDragOver={e => { e.preventDefault(); setDragOverCol(col.id); }}
                                      onDragLeave={() => setDragOverCol(null)}
                                      onDrop={e => {
                                        e.preventDefault();
                                        if (draggedTaskId && col.id !== getTaskStatus(projectTasks.find(tk => tk.id === draggedTaskId))) {
                                          updateTaskStatus(draggedTaskId, selectedProject.id, col.id);
                                          addToast(`Task moved to ${col.label}`, "info");
                                        }
                                        setDraggedTaskId(null); setDragOverCol(null);
                                      }}
                                      style={{ background: isDragOver ? col.color + "0d" : t.card, border: `1px solid ${isDragOver ? col.color + "60" : t.cardBorder}`, borderRadius: "12px", overflow: "hidden", transition: "border-color 0.15s, background 0.15s" }}>
                                      <div style={{ padding: "10px 14px", borderBottom: `1px solid ${t.divider}`, display: "flex", alignItems: "center", gap: "7px" }}>
                                        <span style={{ fontSize: "14px", color: col.color }}>{col.icon}</span>
                                        <span style={{ fontSize: "11px", fontWeight: "700", color: col.color, textTransform: "uppercase", letterSpacing: "0.06em" }}>{col.label}</span>
                                        <span style={{ marginLeft: "auto", fontSize: "11px", fontWeight: "700", color: t.muted, background: t.hover, borderRadius: "99px", padding: "1px 7px" }}>{colTasks.length}</span>
                                      </div>
                                      <div style={{ padding: "10px", display: "flex", flexDirection: "column", gap: "7px", minHeight: "80px" }}>
                                        {colTasks.map(task => {
                                          const prio = task.priority || "medium";
                                          const pc = prioMeta[prio]?.color || t.muted;
