                        style={{ width: "36px", height: "36px", borderRadius: "10px", background: t.hover, border: `1px solid ${t.cardBorder}`, color: t.muted, display: "flex", alignItems: "center", justifyContent: "center", cursor: "pointer", transition: "all 0.15s" }}
                        onMouseEnter={e => { e.currentTarget.style.background = t.green + "18"; e.currentTarget.style.color = t.green; e.currentTarget.style.borderColor = t.green + "50"; }}
                        onMouseLeave={e => { e.currentTarget.style.background = t.hover; e.currentTarget.style.color = t.muted; e.currentTarget.style.borderColor = t.cardBorder; }}
                      ><Ic.Phone /></button>
                      <button
                        onClick={() => setCallingModal("video")}
                        title="Video Call"
                        style={{ width: "36px", height: "36px", borderRadius: "10px", background: t.hover, border: `1px solid ${t.cardBorder}`, color: t.muted, display: "flex", alignItems: "center", justifyContent: "center", cursor: "pointer", transition: "all 0.15s" }}
                        onMouseEnter={e => { e.currentTarget.style.background = t.blue + "18"; e.currentTarget.style.color = t.blue; e.currentTarget.style.borderColor = t.blue + "50"; }}
                        onMouseLeave={e => { e.currentTarget.style.background = t.hover; e.currentTarget.style.color = t.muted; e.currentTarget.style.borderColor = t.cardBorder; }}
