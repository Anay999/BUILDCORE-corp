                    const ih = e.target.naturalHeight;
                    const scale = Math.max(280 / iw, 280 / ih);
                    const dw = iw * scale;
                    const dh = ih * scale;
                    setCropImgW(dw);
                    setCropImgH(dh);
                    setCropX((280 - dw) / 2);
                    setCropY((280 - dh) / 2);
                  }}
                />
