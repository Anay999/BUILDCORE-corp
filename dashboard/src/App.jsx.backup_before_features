                          <div key={item.label} onClick={() => { chatFileRef.current.accept = item.accept; chatFileRef.current.click(); }}
                            style={{ display: "flex", alignItems: "center", gap: "10px", padding: "11px 16px", cursor: "pointer", color: item.color, fontSize: "13px", fontWeight: "500", transition: "background 0.1s" }}
