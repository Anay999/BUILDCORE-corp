                      ? <img src={`http://localhost:5000/uploads/${selectedChat.profile_picture}`} alt={selectedChat.name} style={{ width: "36px", height: "36px", borderRadius: "50%", objectFit: "cover", border: `2px solid ${avatarColor(selectedChat.id)}40` }} />
                      : <div style={{ width: "36px", height: "36px", borderRadius: "50%", background: avatarColor(selectedChat.id) + "20", border: `2px solid ${avatarColor(selectedChat.id)}40`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: "14px", fontWeight: "700", color: avatarColor(selectedChat.id) }}>{(selectedChat.name || "?").charAt(0).toUpperCase()}</div>
