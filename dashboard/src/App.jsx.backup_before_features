                            onMouseEnter={e => e.currentTarget.style.background = t.hover}
                            onMouseLeave={e => e.currentTarget.style.background = "transparent"}
                          >{emoji}</span>
                        ))}
                      </div>
                    )}

                    {/* + button */}
                    <button onClick={e => { e.stopPropagation(); setShowAttachMenu(v => !v); setShowEmojiPicker(false); }}
                      style={{ width: "36px", height: "36px", borderRadius: "10px", background: showAttachMenu ? t.accentDim : t.hover, border: `1px solid ${showAttachMenu ? t.accent : t.cardBorder}`, color: showAttachMenu ? t.accent : t.muted, display: "flex", alignItems: "center", justifyContent: "center", cursor: "pointer", flexShrink: 0, transition: "all 0.15s", fontSize: "20px", fontWeight: "300" }}
                    >+</button>

                    {/* text input */}
                    <input value={chatInput} onChange={e => setChatInput(e.target.value)}
                      onKeyDown={async e => {
                        if (e.key === "Enter" && !e.shiftKey) {
                          e.preventDefault();
                          setShowEmojiPicker(false);
                          // send staged files first
                          for (const sf of stagedFiles) {
                            if (sf.type === "image") {
                              try {
                                const fd = new FormData(); fd.append("file", sf.file);
                                const r = await axios.post("http://localhost:5000/api/messages/upload", fd, { headers: { ...headers(), "Content-Type": "multipart/form-data" } });
                                const msgR = await axios.post("http://localhost:5000/api/messages", { receiver_id: selectedChat.id, content: `[img:${r.data.filename}]` }, { headers: headers() });
                                setChatMessages(prev => [...prev, msgR.data]);
                              } catch(err) { console.log(err); }
                            } else {
                              const msgR = await axios.post("http://localhost:5000/api/messages", { receiver_id: selectedChat.id, content: `📎 ${sf.file.name}` }, { headers: headers() }).catch(console.log);
                              if (msgR) setChatMessages(prev => [...prev, msgR.data]);
                            }
