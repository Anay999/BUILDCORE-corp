                              <Ic.FileDoc /><div style={{ fontSize: "9px", color: t.muted, textAlign: "center", padding: "0 4px", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap", maxWidth: "68px" }}>{sf.file.name}</div>
                            </div>
                          )}
                          <button onClick={() => setStagedFiles(prev => prev.filter((_, i) => i !== idx))}
                            style={{ position: "absolute", top: "-5px", right: "-5px", width: "18px", height: "18px", borderRadius: "50%", background: t.red, border: "none", color: "#fff", fontSize: "10px", cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", lineHeight: 1 }}
                          >✕</button>
                        </div>
                      ))}
                    </div>
                  )}

                  {/* input bar */}
                  <div style={{ padding: "10px 14px", borderTop: stagedFiles.length > 0 ? "none" : `1px solid ${t.divider}`, display: "flex", gap: "8px", alignItems: "center", flexShrink: 0, position: "relative" }}>

