                          const burnHealth = burnRatio <= timeElapsed + 0.05 ? 1 : burnRatio <= timeElapsed + 0.15 ? 0.6 : 0.3;
                          const aiScore   = Math.round(taskDone * 35 + mileDone * 25 + logScore * 20 + burnHealth * 20);

                          const scoreCol  = aiScore >= 70 ? "#22c55e" : aiScore >= 40 ? "#f59e0b" : "#ef4444";
                          const signals = [
