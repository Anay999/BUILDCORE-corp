                              </div>
                              <div style={{ display: "grid", gridTemplateColumns: "repeat(2,1fr)", gap: "8px" }}>
                                {signals.map((s,i) => {
                                  const sCol = s.val >= 70 ? "#22c55e" : s.val >= 40 ? "#f59e0b" : "#ef4444";
                                  return (
                                    <div key={i} style={{ background: t.hover, borderRadius: "9px", padding: "10px 12px", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                                      <div>
                                        <div style={{ fontSize: "10px", color: t.muted, marginBottom: "2px" }}>{s.icon} {s.label} <span style={{ color: t.muted, opacity: 0.6 }}>({s.weight}%)</span></div>
