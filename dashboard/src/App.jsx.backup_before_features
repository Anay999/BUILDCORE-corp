          />
          <button onClick={() => setLightboxSrc(null)}
            style={{ position: "absolute", top: "20px", right: "20px", width: "36px", height: "36px", borderRadius: "50%", background: "rgba(255,255,255,0.15)", border: "none", color: "#fff", fontSize: "18px", cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center" }}>
            ✕
          </button>
          <div style={{ position: "absolute", bottom: "20px", fontSize: "12px", color: "rgba(255,255,255,0.5)" }}>Click image to zoom · Click outside to close</div>
        </div>
      )}

      {showLogoutConfirm && (
        <div style={{ position: "fixed", inset: 0, background: "rgba(0,0,0,0.6)", zIndex: 999, display: "flex", alignItems: "center", justifyContent: "center" }}>
          <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "16px", padding: "32px 28px", maxWidth: "360px", width: "90%", boxShadow: "0 24px 60px rgba(0,0,0,0.4)" }}>
            <div style={{ fontSize: "16px", fontWeight: "700", color: t.text, marginBottom: "10px" }}>Sign out?</div>
            <div style={{ fontSize: "13px", color: t.muted, marginBottom: "24px" }}>You will need to log in again to access BuildCore.</div>
            <div style={{ display: "flex", gap: "10px" }}>
              <button onClick={() => setShowLogoutConfirm(false)}
                style={{ flex: 1, padding: "10px", borderRadius: "9px", border: `1px solid ${t.cardBorder}`, background: t.hover, color: t.text, fontWeight: "600", fontSize: "13px", cursor: "pointer" }}>Cancel</button>
              <button onClick={() => { localStorage.removeItem("token"); localStorage.removeItem("user"); window.location.reload(); }}
                style={{ flex: 1, padding: "10px", borderRadius: "9px", border: "none", background: "#ef4444", color: "#fff", fontWeight: "700", fontSize: "13px", cursor: "pointer" }}>Sign Out</button>
            </div>
          </div>
        </div>
      )}

      {showVerifyPwModal && (
        <div style={{ position: "fixed", inset: 0, background: "rgba(0,0,0,0.6)", zIndex: 999, display: "flex", alignItems: "center", justifyContent: "center" }}>
          <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "16px", padding: "28px", maxWidth: "340px", width: "90%", boxShadow: "0 20px 50px rgba(0,0,0,0.4)" }}>
            <div style={{ fontSize: "15px", fontWeight: "700", color: t.text, marginBottom: "8px" }}>🔒 Verify Identity</div>
            <div style={{ fontSize: "13px", color: t.muted, marginBottom: "18px" }}>Enter your password to unlock profile info.</div>
            <input type="password" value={verifyPwInput} onChange={e => setVerifyPwInput(e.target.value)}
              placeholder="Your password" style={{ ...inputSt, marginBottom: "8px" }} />
            {verifyPwError && <div style={{ color: "#ef4444", fontSize: "12px", marginBottom: "8px" }}>{verifyPwError}</div>}
            <div style={{ display: "flex", gap: "10px", marginTop: "4px" }}>
              <button onClick={() => { setShowVerifyPwModal(false); setVerifyPwInput(""); setVerifyPwError(""); }}
                style={{ flex: 1, padding: "9px", borderRadius: "8px", border: `1px solid ${t.cardBorder}`, background: t.hover, color: t.text, fontWeight: "600", fontSize: "13px", cursor: "pointer" }}>Cancel</button>
              <button onClick={async () => {
                try {
                  await axios.post("http://localhost:5000/api/auth/verify-password", { password: verifyPwInput }, { headers: headers() });
                  setProfileUnlocked(true); setShowVerifyPwModal(false); setVerifyPwInput(""); setVerifyPwError("");
                } catch { setVerifyPwError("Incorrect password."); }
              }} style={{ flex: 1, padding: "9px", borderRadius: "8px", border: "none", background: t.accent, color: "#0f172a", fontWeight: "700", fontSize: "13px", cursor: "pointer" }}>Verify</button>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}

export default App;
