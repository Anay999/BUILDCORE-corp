                        })()}

                        {/* P&L Stock-Market Chart */}
                        {(() => {
                          const pl2 = plData[selectedProject.id];
                          const projExps2 = expenses[selectedProject.id] || [];

                          // Build monthly cumulative spend vs budget burn line
                          const budget2 = Number(selectedProject.budget) || 1;
                          const contractVal2 = pl2?.revenue?.contractValue || 0;

                          // Group expenses by month
                          const byMonth = {};
                          projExps2.forEach(e2 => {
                            const d = new Date(e2.created_at || e2.date || Date.now());
                            const key = d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2,"0");
                            byMonth[key] = (byMonth[key] || 0) + Number(e2.amount || 0);
                          });

                          // Also use burnByMonth from PnL if available
                          const burnSrc = pl2?.burnByMonth || {};
                          Object.entries(burnSrc).forEach(([k,v]) => {
                            byMonth[k] = (byMonth[k] || 0) + Number(v || 0);
                          });

                          const months = Object.keys(byMonth).sort();

                          // If no expense data, generate illustrative projection lines
                          let chartData = [];
                          if (months.length === 0) {
                            // Projection only — 6 future months
                            const now = new Date();
                            let cumTarget = 0;
                            for (let i = 0; i < 6; i++) {
                              const d = new Date(now.getFullYear(), now.getMonth() + i, 1);
                              const label = d.toLocaleString("en-IN", { month: "short", year: "2-digit" });
                              cumTarget += budget2 / 12;
                              const projected = contractVal2 > 0 ? contractVal2 - cumTarget : null;
                              chartData.push({ month: label, budget: Math.round(cumTarget), projected: projected ? Math.round(projected) : null, actual: null });
                            }
                          } else {
                            let cumActual = 0;
                            months.forEach(m => {
                              cumActual += byMonth[m];
                              const [yr, mo] = m.split("-");
                              const label = new Date(yr, mo-1, 1).toLocaleString("en-IN", { month: "short", year: "2-digit" });
                              const projected = contractVal2 > 0 ? Math.round(contractVal2 - cumActual) : null;
                              chartData.push({ month: label, actual: Math.round(cumActual), projected, budget: Math.round(budget2 * (months.indexOf(m)+1) / months.length) });
                            });
                          }

                          if (chartData.length === 0) return null;

                          const maxVal = Math.max(...chartData.flatMap(d => [d.actual||0, d.budget||0, Math.abs(d.projected||0)])) * 1.15 || 1;
                          const chartH = 140;
                          const chartW = 100; // percent width
                          const pts = (arr, key, color, fill) => {
                            const valid = arr.filter(d => d[key] !== null && d[key] !== undefined);
                            if (valid.length < 2) return null;
                            const points = valid.map((d,i) => {
                              const x = (arr.indexOf(d) / (arr.length - 1)) * 100;
                              const y = chartH - (Math.max(0,d[key]) / maxVal) * chartH;
                              return `${x},${y}`;
                            }).join(" ");
                            const firstX = (arr.indexOf(valid[0]) / (arr.length - 1)) * 100;
                            const lastX = (arr.indexOf(valid[valid.length-1]) / (arr.length - 1)) * 100;
                            return { points, firstX, lastX, color, fill, key };
                          };

                          const lines = [
                            pts(chartData, "actual",    "#3b82f6", "#3b82f620"),
                            pts(chartData, "budget",    "#f59e0b", "#f59e0b10"),
                            pts(chartData, "projected", "#22c55e", "#22c55e10"),
                          ].filter(Boolean);

                          const lastEntry = chartData[chartData.length - 1];
                          const profitVal = lastEntry?.projected;
                          const profitCol = profitVal === null ? t.muted : profitVal >= 0 ? "#22c55e" : "#ef4444";

                          return (
                            <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", padding: "18px 20px" }}>
                              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: "14px" }}>
                                <div>
                                  <div style={{ fontSize: "10px", color: t.muted, fontWeight: "700", textTransform: "uppercase", letterSpacing: "0.08em", marginBottom: "3px" }}>P&L TRACKER</div>
                                  <div style={{ fontSize: "14px", fontWeight: "700", color: t.text }}>Budget vs Spend vs Profit</div>
                                </div>
                                <div style={{ textAlign: "right" }}>
                                  {profitVal !== null && (
                                    <>
                                      <div style={{ fontSize: "9px", color: t.muted, marginBottom: "2px" }}>Projected Profit</div>
                                      <div style={{ fontFamily: "'Barlow Condensed',sans-serif", fontSize: "22px", fontWeight: "900", color: profitCol }}>
                                        {profitVal >= 0 ? "+" : ""}{(profitVal/1e5).toFixed(1)}L
                                      </div>
                                    </>
                                  )}
                                </div>
                              </div>

                              {/* SVG chart */}
                              <div style={{ position: "relative", width: "100%", height: chartH + 28 + "px" }}>
                                <svg viewBox={`0 0 100 ${chartH}`} preserveAspectRatio="none"
                                  style={{ position: "absolute", top: 0, left: 0, width: "100%", height: chartH + "px" }}>
                                  {/* grid lines */}
                                  {[0.25,0.5,0.75,1].map(r => (
                                    <line key={r} x1="0" y1={chartH * (1-r)} x2="100" y2={chartH * (1-r)}
                                      stroke="rgba(255,255,255,0.04)" strokeWidth="0.3" />
                                  ))}
                                  {/* fill areas */}
                                  {lines.map((l,i) => {
                                    const pts2 = l.points.split(" ");
                                    const first = pts2[0].split(",");
                                    const last2 = pts2[pts2.length-1].split(",");
                                    return (
                                      <polygon key={"fill"+i}
                                        points={`${l.points} ${last2[0]},${chartH} ${first[0]},${chartH}`}
                                        fill={l.fill} />
                                    );
                                  })}
                                  {/* lines */}
                                  {lines.map((l,i) => (
                                    <polyline key={"line"+i} points={l.points} fill="none"
                                      stroke={l.color} strokeWidth="0.8" strokeLinecap="round" strokeLinejoin="round" />
                                  ))}
                                  {/* end dots */}
                                  {lines.map((l,i) => {
                                    const last2 = l.points.split(" ").pop().split(",");
                                    return <circle key={"dot"+i} cx={last2[0]} cy={last2[1]} r="1.2" fill={l.color} />;
                                  })}
                                </svg>
                                {/* x-axis labels */}
                                <div style={{ position: "absolute", bottom: 0, left: 0, right: 0, display: "flex", justifyContent: "space-between" }}>
                                  {chartData.map((d,i) => (
                                    <div key={i} style={{ fontSize: "9px", color: t.muted, textAlign: "center" }}>{d.month}</div>
                                  ))}
                                </div>
                              </div>

                              {/* legend */}
                              <div style={{ display: "flex", gap: "16px", marginTop: "10px", flexWrap: "wrap" }}>
                                {[
                                  { col: "#3b82f6", label: "Actual Spend" },
                                  { col: "#f59e0b", label: "Budget Burn" },
                                  { col: "#22c55e", label: "Projected Profit" },
                                ].map((l,i) => (
                                  <div key={i} style={{ display: "flex", alignItems: "center", gap: "5px" }}>
                                    <div style={{ width: "20px", height: "2px", background: l.col, borderRadius: "2px" }} />
                                    <span style={{ fontSize: "10px", color: t.muted }}>{l.label}</span>
                                  </div>
                                ))}
                              </div>
                            </div>
                          );
                        })()}

                        {/* AI Health & Delay Risk card */}
                        {(() => {
                          const projAnalyses = pendingAnalyses.filter(a => String(a.project_id) === String(selectedProject.id));
                          const latest = projAnalyses[0];
