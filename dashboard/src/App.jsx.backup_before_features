                              <span style={{ color: t.muted, fontSize: "12px" }}> — {log.logged_by_name}</span>
                            </div>
                            <div style={{ fontSize: "12px", color: t.muted, marginTop: "2px", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{log.work_done}</div>
