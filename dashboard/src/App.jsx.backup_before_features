                    {/* ══ GANTT TAB ══ */}
                    {projectTab === "gantt" && (() => {
                      const ms = milestones[selectedProject.id] || [];
                      const ROW_H = 44, LABEL_W = 200, DAY_W = 28, HEADER_H = 56;

                      // Build bars — derive start_date from previous milestone if missing
                      const sorted = [...ms].sort((a, b) => new Date(a.due_date || '9999') - new Date(b.due_date || '9999'));
                      const bars = sorted.map((m, i) => {
                        const end = m.due_date ? new Date(m.due_date) : null;
                        let start = m.start_date ? new Date(m.start_date) : null;
                        if (!start && end) {
                          // default: start 7 days before due or after prev milestone
                          const prev = sorted[i - 1];
                          start = prev?.due_date ? new Date(prev.due_date) : new Date(new Date(end).setDate(end.getDate() - 7));
                        }
                        return { ...m, startD: start, endD: end };
                      }).filter(b => b.startD && b.endD);

                      if (ms.length === 0) return (
                        <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", padding: "80px 40px", textAlign: "center", boxShadow: t.shadow }}>
                          <div style={{ fontSize: "40px", marginBottom: "12px" }}>📅</div>
                          <div style={{ fontSize: "16px", fontWeight: "700", color: t.text, marginBottom: "6px" }}>No milestones yet</div>
                          <div style={{ fontSize: "13px", color: t.muted }}>Add milestones with start + end dates in the Milestones tab to see them here.</div>
                        </div>
                      );

                      if (bars.length === 0) return (
                        <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", padding: "60px 40px", textAlign: "center", boxShadow: t.shadow }}>
                          <div style={{ fontSize: "36px", marginBottom: "10px" }}>📅</div>
                          <div style={{ fontSize: "15px", fontWeight: "600", color: t.text, marginBottom: "6px" }}>Set dates to see the Gantt</div>
                          <div style={{ fontSize: "12px", color: t.muted }}>Go to the Milestones tab → add start &amp; end dates for each milestone.</div>
                        </div>
                      );

                      // Timeline range
                      const minDate = new Date(Math.min(...bars.map(b => b.startD)));
                      const maxDate = new Date(Math.max(...bars.map(b => b.endD)));
                      minDate.setDate(minDate.getDate() - 3);
                      maxDate.setDate(maxDate.getDate() + 5);
                      const totalDays = Math.ceil((maxDate - minDate) / 86400000);
                      const today = new Date();
                      const todayX = Math.floor((today - minDate) / 86400000) * DAY_W;

                      const dateToX = (d) => Math.floor((new Date(d) - minDate) / 86400000) * DAY_W;

                      // Drag state (ref to avoid re-render during drag)
                      const onBarMouseDown = (e, bar) => {
                        if (!can(user.role, 'canEditProject')) return;
                        e.preventDefault();
                        const startX = e.clientX;
                        const origStart = new Date(bar.startD);
                        const origEnd = new Date(bar.endD);
                        const duration = Math.round((origEnd - origStart) / 86400000);

                        const onMove = (ev) => {
                          const dx = ev.clientX - startX;
                          const ddays = Math.round(dx / DAY_W);
                          if (ganttDragRef.current?.id !== bar.id) return;
                          const ns = new Date(origStart); ns.setDate(ns.getDate() + ddays);
                          const ne = new Date(ns); ne.setDate(ne.getDate() + duration);
                          ganttDragRef.current.newStart = ns.toISOString().slice(0,10);
                          ganttDragRef.current.newEnd = ne.toISOString().slice(0,10);
                          // Live visual feedback via DOM
                          const el = document.getElementById('gantt-bar-' + bar.id);
                          if (el) {
                            el.style.left = dateToX(ns) + 'px';
                            el.style.width = Math.max(DAY_W, duration * DAY_W) + 'px';
                          }
                          const lbl = document.getElementById('gantt-lbl-' + bar.id);
                          if (lbl) lbl.textContent = ns.toLocaleDateString('en-IN',{day:'numeric',month:'short'}) + ' → ' + ne.toLocaleDateString('en-IN',{day:'numeric',month:'short'});
                        };
                        const onUp = () => {
                          document.removeEventListener('mousemove', onMove);
                          document.removeEventListener('mouseup', onUp);
                          const drag = ganttDragRef.current;
                          if (drag?.newStart && drag?.id === bar.id) {
                            updateMilestoneDates(bar.id, selectedProject.id, drag.newStart, drag.newEnd);
                          }
                          ganttDragRef.current = null;
                        };
                        ganttDragRef.current = { id: bar.id };
                        document.addEventListener('mousemove', onMove);
                        document.addEventListener('mouseup', onUp);
                      };

                      // Build week headers
                      const weeks = [];
                      let cur = new Date(minDate);
                      while (cur < maxDate) {
                        const weekStart = new Date(cur);
                        const daysLeft = Math.ceil((maxDate - cur) / 86400000);
                        const daysInWeek = Math.min(7, daysLeft);
                        weeks.push({ date: new Date(cur), days: daysInWeek, x: dateToX(cur) });
                        cur.setDate(cur.getDate() + 7);
                      }

                      const totalW = totalDays * DAY_W;
                      const totalH = HEADER_H + bars.length * ROW_H + 12;

                      return (
                        <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", overflow: "hidden", boxShadow: t.shadow }}>
                          {/* Header */}
                          <div style={{ padding: "16px 20px", borderBottom: `1px solid ${t.divider}`, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                            <div style={{ fontSize: "14px", fontWeight: "700", color: t.text }}>📅 Project Gantt Chart</div>
                            <div style={{ fontSize: "12px", color: t.muted }}>{bars.length} milestone{bars.length !== 1 ? "s" : ""} · {can(user.role, "canEditProject") ? "Drag bars to reschedule" : "Read-only"}</div>
                          </div>

                          {/* Chart area */}
                          <div style={{ overflowX: "auto", overflowY: "auto", maxHeight: "520px" }}>
                            <div style={{ display: "flex", minWidth: LABEL_W + totalW + "px" }}>

                              {/* Label column (sticky) */}
                              <div style={{ width: LABEL_W + "px", flexShrink: 0, position: "sticky", left: 0, zIndex: 3, background: t.card, borderRight: `1px solid ${t.divider}` }}>
                                {/* corner */}
                                <div style={{ height: HEADER_H + "px", borderBottom: `1px solid ${t.divider}`, padding: "0 14px", display: "flex", alignItems: "flex-end", paddingBottom: "8px" }}>
                                  <span style={{ fontSize: "10px", fontWeight: "700", color: t.muted, textTransform: "uppercase", letterSpacing: "0.07em" }}>Milestone</span>
                                </div>
                                {/* rows */}
                                {bars.map((bar, i) => {
                                  const overdue = !bar.completed && bar.endD < today;
                                  const barColor = bar.completed ? "#10b981" : overdue ? "#ef4444" : t.accent;
                                  return (
                                    <div key={bar.id} style={{ height: ROW_H + "px", display: "flex", alignItems: "center", padding: "0 14px", gap: "8px", borderBottom: `1px solid ${t.divider}20` }}>
                                      <div style={{ width: "8px", height: "8px", borderRadius: "50%", background: barColor, flexShrink: 0 }} />
                                      <div style={{ overflow: "hidden" }}>
                                        <div style={{ fontSize: "12px", fontWeight: "600", color: t.text, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", maxWidth: LABEL_W - 40 + "px" }}>{bar.title}</div>
                                        <div style={{ fontSize: "10px", color: t.muted }}>{bar.completed ? "✅ Done" : overdue ? "⚠️ Overdue" : "🔄 Active"}</div>
                                      </div>
                                    </div>
                                  );
                                })}
                              </div>

                              {/* Timeline area */}
                              <div style={{ position: "relative", width: totalW + "px", flexShrink: 0 }}>

                                {/* Week + day header */}
                                <div style={{ height: HEADER_H + "px", position: "sticky", top: 0, zIndex: 2, background: t.card, borderBottom: `1px solid ${t.divider}` }}>
                                  {/* Week labels */}
                                  {weeks.map((w, i) => (
                                    <div key={i} style={{ position: "absolute", left: w.x + "px", top: 0, width: w.days * DAY_W + "px", borderRight: `1px solid ${t.divider}40`, padding: "6px 6px 0", overflow: "hidden" }}>
                                      <div style={{ fontSize: "10px", fontWeight: "700", color: t.muted, textTransform: "uppercase", letterSpacing: "0.06em", whiteSpace: "nowrap" }}>
                                        {w.date.toLocaleDateString("en-IN", { day: "numeric", month: "short" })}
                                      </div>
                                    </div>
                                  ))}
                                  {/* Day numbers */}
                                  {Array.from({ length: totalDays }).map((_, i) => {
                                    const d = new Date(minDate); d.setDate(d.getDate() + i);
                                    const isToday = d.toDateString() === today.toDateString();
                                    const isWeekend = d.getDay() === 0 || d.getDay() === 6;
                                    return (
                                      <div key={i} style={{ position: "absolute", left: i * DAY_W + "px", bottom: 0, width: DAY_W + "px", height: "28px", display: "flex", alignItems: "center", justifyContent: "center", background: isToday ? t.accent + "22" : isWeekend ? t.hover : "transparent", borderLeft: isToday ? `2px solid ${t.accent}` : "none" }}>
                                        <span style={{ fontSize: "9px", fontWeight: isToday ? "800" : "500", color: isToday ? t.accent : isWeekend ? t.muted : t.text + "99" }}>{d.getDate()}</span>
                                      </div>
                                    );
                                  })}
                                </div>

                                {/* Row backgrounds + grid lines */}
                                {bars.map((bar, i) => (
                                  <div key={bar.id} style={{ position: "absolute", left: 0, top: HEADER_H + i * ROW_H + "px", width: totalW + "px", height: ROW_H + "px", background: i % 2 === 0 ? "transparent" : darkMode ? "rgba(255,255,255,0.02)" : "rgba(0,0,0,0.015)", borderBottom: `1px solid ${t.divider}15` }} />
                                ))}

                                {/* Weekend shading */}
                                {Array.from({ length: totalDays }).map((_, i) => {
                                  const d = new Date(minDate); d.setDate(d.getDate() + i);
                                  if (d.getDay() !== 0 && d.getDay() !== 6) return null;
                                  return <div key={i} style={{ position: "absolute", left: i * DAY_W + "px", top: HEADER_H + "px", width: DAY_W + "px", height: bars.length * ROW_H + "px", background: darkMode ? "rgba(255,255,255,0.025)" : "rgba(0,0,0,0.03)", pointerEvents: "none" }} />;
                                })}

                                {/* Today line */}
                                {todayX >= 0 && todayX <= totalW && (
                                  <div style={{ position: "absolute", left: todayX + "px", top: HEADER_H + "px", width: "2px", height: bars.length * ROW_H + "px", background: t.accent, opacity: 0.8, pointerEvents: "none", zIndex: 2 }}>
                                    <div style={{ position: "absolute", top: "-2px", left: "-4px", width: "10px", height: "10px", borderRadius: "50%", background: t.accent }} />
                                  </div>
                                )}

                                {/* Milestone bars */}
                                {bars.map((bar, i) => {
                                  const x = dateToX(bar.startD);
                                  const w = Math.max(DAY_W, Math.ceil((bar.endD - bar.startD) / 86400000) * DAY_W);
                                  const overdue = !bar.completed && bar.endD < today;
                                  const barColor = bar.completed ? "#10b981" : overdue ? "#ef4444" : t.accent;
                                  const y = HEADER_H + i * ROW_H + ROW_H * 0.2;
                                  const bh = ROW_H * 0.6;
                                  return (
                                    <div key={bar.id} id={"gantt-bar-" + bar.id}
                                      onMouseDown={(e) => onBarMouseDown(e, bar)}
                                      style={{ position: "absolute", left: x + "px", top: y + "px", width: w + "px", height: bh + "px", background: `linear-gradient(90deg, ${barColor}, ${barColor}cc)`, borderRadius: "6px", cursor: can(user.role, "canEditProject") ? "grab" : "default", zIndex: 1, display: "flex", alignItems: "center", overflow: "hidden", userSelect: "none", boxShadow: `0 2px 8px ${barColor}40`, border: `1px solid ${barColor}60`, transition: "box-shadow 0.15s" }}
                                      onMouseEnter={e => { e.currentTarget.style.boxShadow = `0 4px 14px ${barColor}70`; e.currentTarget.style.zIndex = "3"; }}
                                      onMouseLeave={e => { e.currentTarget.style.boxShadow = `0 2px 8px ${barColor}40`; e.currentTarget.style.zIndex = "1"; }}
                                      title={`${bar.title}\n${bar.startD.toLocaleDateString('en-IN')} → ${bar.endD.toLocaleDateString('en-IN')}`}>
                                      <div style={{ padding: "0 8px", fontSize: "11px", fontWeight: "700", color: "#fff", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", flex: 1 }}>{bar.title}</div>
                                      {bar.completed && <div style={{ padding: "0 6px", fontSize: "12px" }}>✅</div>}
                                    </div>
                                  );
                                })}

                                {/* Date labels below bars */}
                                {bars.map((bar, i) => {
                                  const x = dateToX(bar.startD);
                                  const y = HEADER_H + i * ROW_H + ROW_H * 0.78;
                                  return (
                                    <div key={bar.id} id={"gantt-lbl-" + bar.id} style={{ position: "absolute", left: x + "px", top: y + "px", fontSize: "9px", color: t.muted, whiteSpace: "nowrap", pointerEvents: "none" }}>
                                      {bar.startD.toLocaleDateString("en-IN", { day: "numeric", month: "short" })} → {bar.endD.toLocaleDateString("en-IN", { day: "numeric", month: "short" })}
                                    </div>
                                  );
                                })}

                              </div>
                            </div>
                          </div>

                          {/* Legend */}
                          <div style={{ padding: "12px 20px", borderTop: `1px solid ${t.divider}`, display: "flex", gap: "20px", flexWrap: "wrap" }}>
                            {[["#10b981","Completed"],["#ef4444","Overdue"],[t.accent,"On Track"]].map(([c,l]) => (
                              <div key={l} style={{ display: "flex", alignItems: "center", gap: "6px" }}>
                                <div style={{ width: "20px", height: "8px", borderRadius: "4px", background: c }} />
                                <span style={{ fontSize: "11px", color: t.muted }}>{l}</span>
                              </div>
                            ))}
                            <div style={{ display: "flex", alignItems: "center", gap: "6px" }}>
                              <div style={{ width: "2px", height: "14px", background: t.accent }} />
                              <span style={{ fontSize: "11px", color: t.muted }}>Today</span>
                            </div>
                          </div>
                        </div>
                      );
                    })()}

                    {/* ══ MATERIALS TAB ══ */}
                    {projectTab === "materials" && (() => {
                      const mats = materials[selectedProject.id] || [];
                      const lowStock = mats.filter(m => m.is_low_stock);
                      const totalCost = mats.reduce((s, m) => s + Number(m.total_cost || 0), 0);
                      const costUsed  = mats.reduce((s, m) => s + Number(m.cost_used  || 0), 0);
                      const cardSt = { background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", padding: "22px", boxShadow: t.shadow };
                      const UNITS = ["bags","tons","kg","litres","sqft","sqm","rft","units","pieces","boxes","sheets","rolls","trucks"];

                      return (
                        <div style={{ display: "flex", flexDirection: "column", gap: "16px" }}>

                          {/* ── KPI row ── */}
                          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(160px, 1fr))", gap: "12px" }}>
                            {[
                              { label: "Total Items",   value: mats.length,                    color: t.accent,  icon: "📦" },
                              { label: "Low Stock",     value: lowStock.length,                color: lowStock.length > 0 ? "#ef4444" : "#10b981", icon: "⚠️" },
                              { label: "Total Value",   value: "₹" + totalCost.toLocaleString("en-IN"), color: "#3b82f6",  icon: "💰" },
                              { label: "Cost Used",     value: "₹" + costUsed.toLocaleString("en-IN"),  color: "#f59e0b",  icon: "🔧" },
                            ].map((k, i) => (
                              <div key={i} style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "12px", padding: "14px 16px", boxShadow: t.shadow }}>
                                <div style={{ fontSize: "20px", marginBottom: "6px" }}>{k.icon}</div>
                                <div style={{ fontSize: "20px", fontWeight: "800", color: k.color, fontFamily: "'Barlow Condensed', sans-serif" }}>{k.value}</div>
                                <div style={{ fontSize: "11px", color: t.muted, fontWeight: "600" }}>{k.label}</div>
                              </div>
                            ))}
                          </div>

                          {/* ── Low stock alert bar ── */}
                          {lowStock.length > 0 && (
                            <div style={{ background: "rgba(239,68,68,0.08)", border: "1px solid rgba(239,68,68,0.25)", borderRadius: "10px", padding: "12px 16px", display: "flex", alignItems: "center", gap: "10px" }}>
                              <span style={{ fontSize: "16px" }}>🚨</span>
                              <div>
                                <span style={{ fontSize: "13px", fontWeight: "700", color: "#ef4444" }}>Low Stock Alert: </span>
                                <span style={{ fontSize: "13px", color: t.muted }}>{lowStock.map(m => m.name).join(", ")}</span>
                              </div>
                            </div>
                          )}

                          {/* ── Add material form ── */}
                          {can(user.role, "canAddExpense") && (
                            <div style={cardSt}>
                              <div style={{ fontSize: "12px", fontWeight: "700", color: t.muted, textTransform: "uppercase", letterSpacing: "0.08em", marginBottom: "14px" }}>Add Material</div>
                              <div style={{ display: "grid", gridTemplateColumns: "2fr 1fr", gap: "10px", marginBottom: "10px" }}>
                                <input style={inputSt} placeholder="Material name e.g. Cement, Steel, Bricks" value={matName} onChange={e => setMatName(e.target.value)} />
                                <select style={inputSt} value={matUnit} onChange={e => setMatUnit(e.target.value)}>
                                  {UNITS.map(u => <option key={u} value={u}>{u}</option>)}
                                </select>
                              </div>
                              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr 1fr", gap: "10px", marginBottom: "10px" }}>
                                <div>
                                  <div style={{ fontSize: "10px", color: t.muted, fontWeight: "600", marginBottom: "4px" }}>Qty Ordered *</div>
                                  <input type="number" style={inputSt} placeholder="e.g. 500" value={matQty} onChange={e => setMatQty(e.target.value)} min="0" />
                                </div>
                                <div>
                                  <div style={{ fontSize: "10px", color: t.muted, fontWeight: "600", marginBottom: "4px" }}>Cost / unit (₹)</div>
                                  <input type="number" style={inputSt} placeholder="e.g. 380" value={matCost} onChange={e => setMatCost(e.target.value)} min="0" />
                                </div>
                                <div>
                                  <div style={{ fontSize: "10px", color: t.muted, fontWeight: "600", marginBottom: "4px" }}>Low stock alert at</div>
                                  <input type="number" style={inputSt} placeholder="e.g. 50" value={matThreshold} onChange={e => setMatThreshold(e.target.value)} min="0" />
                                </div>
                                <div>
                                  <div style={{ fontSize: "10px", color: t.muted, fontWeight: "600", marginBottom: "4px" }}>Supplier</div>
                                  <input style={inputSt} placeholder="Supplier name" value={matSupplier} onChange={e => setMatSupplier(e.target.value)} />
                                </div>
                              </div>
                              <button onClick={() => addMaterial(selectedProject.id)} disabled={!matName.trim() || !matQty}
                                style={{ padding: "10px 20px", background: matName.trim() && matQty ? t.accent : t.hover, border: "none", borderRadius: "9px", color: matName.trim() && matQty ? "#0f172a" : t.muted, fontWeight: "700", fontSize: "13px", cursor: matName.trim() && matQty ? "pointer" : "not-allowed" }}>
                                + Add Material
                              </button>
                            </div>
                          )}

                          {/* ── Material cards ── */}
                          {mats.length === 0 ? (
                            <div style={{ ...cardSt, padding: "60px 40px", textAlign: "center" }}>
                              <div style={{ fontSize: "40px", marginBottom: "12px" }}>📦</div>
                              <div style={{ fontSize: "15px", fontWeight: "600", color: t.text, marginBottom: "6px" }}>No materials tracked yet</div>
                              <div style={{ fontSize: "12px", color: t.muted }}>Add cement, steel, bricks and other materials to track usage and costs.</div>
                            </div>
                          ) : (
                            <div style={{ display: "flex", flexDirection: "column", gap: "12px" }}>
                              {mats.map(mat => {
                                const remaining = Number(mat.qty_remaining) || 0;
                                const ordered   = Number(mat.qty_ordered)   || 1;
                                const used      = Number(mat.qty_used)      || 0;
                                const pctUsed   = Math.min(100, Math.round((used / ordered) * 100));
                                const pctRemain = 100 - pctUsed;
                                const isLow     = mat.is_low_stock;
                                const isExpanded = matActiveId === mat.id;
                                const barColor  = isLow ? "#ef4444" : pctUsed > 70 ? "#f59e0b" : "#10b981";

                                return (
                                  <div key={mat.id} style={{ background: t.card, border: `1px solid ${isLow ? "rgba(239,68,68,0.4)" : t.cardBorder}`, borderRadius: "14px", overflow: "hidden", boxShadow: isLow ? "0 0 0 2px rgba(239,68,68,0.1)" : t.shadow }}>

                                    {/* Card header */}
                                    <div style={{ padding: "16px 20px", display: "flex", alignItems: "center", gap: "14px", cursor: "pointer" }}
                                      onClick={() => setMatActiveId(isExpanded ? null : mat.id)}>
                                      <div style={{ width: "40px", height: "40px", borderRadius: "10px", background: barColor + "20", display: "flex", alignItems: "center", justifyContent: "center", fontSize: "18px", flexShrink: 0 }}>📦</div>
                                      <div style={{ flex: 1, minWidth: 0 }}>
                                        <div style={{ display: "flex", alignItems: "center", gap: "8px", marginBottom: "4px" }}>
                                          <span style={{ fontSize: "14px", fontWeight: "700", color: t.text }}>{mat.name}</span>
                                          {isLow && <span style={{ fontSize: "10px", fontWeight: "700", padding: "2px 8px", borderRadius: "99px", background: "rgba(239,68,68,0.12)", color: "#ef4444" }}>⚠️ LOW STOCK</span>}
                                        </div>
                                        <div style={{ fontSize: "11px", color: t.muted }}>{mat.supplier ? `Supplier: ${mat.supplier} · ` : ""}{remaining.toFixed(1)} {mat.unit} remaining of {ordered} {mat.unit}</div>
                                      </div>
                                      {/* Stock bar */}
                                      <div style={{ width: "140px", flexShrink: 0 }}>
                                        <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "4px" }}>
                                          <span style={{ fontSize: "10px", color: t.muted }}>Used {pctUsed}%</span>
                                          <span style={{ fontSize: "10px", color: barColor, fontWeight: "700" }}>{remaining.toFixed(0)} left</span>
                                        </div>
                                        <div style={{ height: "8px", borderRadius: "99px", background: t.hover, overflow: "hidden" }}>
                                          <div style={{ height: "100%", width: pctUsed + "%", background: `linear-gradient(90deg, ${barColor}, ${barColor}cc)`, borderRadius: "99px", transition: "width 0.4s" }} />
                                        </div>
                                      </div>
                                      {/* Cost */}
                                      <div style={{ textAlign: "right", flexShrink: 0 }}>
                                        <div style={{ fontSize: "14px", fontWeight: "800", color: t.text, fontFamily: "'Barlow Condensed', sans-serif" }}>₹{Number(mat.cost_used || 0).toLocaleString("en-IN")}</div>
                                        <div style={{ fontSize: "10px", color: t.muted }}>of ₹{Number(mat.total_cost || 0).toLocaleString("en-IN")}</div>
                                      </div>
                                      <div style={{ color: t.muted, fontSize: "12px", transition: "transform 0.2s", transform: isExpanded ? "rotate(180deg)" : "rotate(0deg)" }}>▼</div>
                                    </div>

                                    {/* Expanded actions */}
                                    {isExpanded && (
                                      <div style={{ borderTop: `1px solid ${t.divider}`, padding: "16px 20px", display: "flex", flexDirection: "column", gap: "14px" }}>
                                        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "14px" }}>

                                          {/* Log Usage */}
                                          {can(user.role, "canAddProgress") && (
                                            <div style={{ background: t.hover, borderRadius: "10px", padding: "14px" }}>
                                              <div style={{ fontSize: "12px", fontWeight: "700", color: t.text, marginBottom: "10px" }}>🔧 Log Usage</div>
                                              <div style={{ display: "flex", gap: "8px", marginBottom: "8px" }}>
                                                <input type="number" style={{ ...inputSt, flex: 1 }} placeholder={`Qty (${mat.unit})`} value={matUseQty} onChange={e => setMatUseQty(e.target.value)} min="0.1" step="0.1" />
                                              </div>
                                              <input style={{ ...inputSt, marginBottom: "8px" }} placeholder="Note (optional)" value={matUseNote} onChange={e => setMatUseNote(e.target.value)} />
                                              <button onClick={() => logMaterialUsage(mat.id, selectedProject.id)} disabled={!matUseQty}
                                                style={{ width: "100%", padding: "8px", background: matUseQty ? "#ef4444" : t.hover, border: "none", borderRadius: "8px", color: matUseQty ? "#fff" : t.muted, fontWeight: "700", fontSize: "12px", cursor: matUseQty ? "pointer" : "not-allowed" }}>
                                                Log Usage
                                              </button>
                                            </div>
                                          )}

                                          {/* Restock */}
                                          {can(user.role, "canAddExpense") && (
                                            <div style={{ background: t.hover, borderRadius: "10px", padding: "14px" }}>
                                              <div style={{ fontSize: "12px", fontWeight: "700", color: t.text, marginBottom: "10px" }}>📥 Restock</div>
                                              <input type="number" style={{ ...inputSt, marginBottom: "8px" }} placeholder={`Add qty (${mat.unit})`} value={matRestockQty} onChange={e => setMatRestockQty(e.target.value)} min="1" />
                                              <button onClick={() => restockMaterial(mat.id, selectedProject.id)} disabled={!matRestockQty}
                                                style={{ width: "100%", padding: "8px", background: matRestockQty ? "#10b981" : t.hover, border: "none", borderRadius: "8px", color: matRestockQty ? "#fff" : t.muted, fontWeight: "700", fontSize: "12px", cursor: matRestockQty ? "pointer" : "not-allowed" }}>
                                                + Add Stock
                                              </button>
                                            </div>
                                          )}
                                        </div>

                                        {/* Stats row */}
                                        <div style={{ display: "flex", gap: "12px", flexWrap: "wrap" }}>
                                          {[
                                            { label: "Unit Cost",    value: "₹" + Number(mat.unit_cost).toLocaleString("en-IN") },
                                            { label: "Total Ordered",value: ordered + " " + mat.unit },
                                            { label: "Used",         value: used.toFixed(1) + " " + mat.unit },
                                            { label: "Remaining",    value: remaining.toFixed(1) + " " + mat.unit },
                                            { label: "Alert at",     value: Number(mat.low_stock_threshold) + " " + mat.unit },
                                          ].map(s => (
                                            <div key={s.label} style={{ background: t.bg, borderRadius: "8px", padding: "8px 12px", flex: 1, minWidth: "100px" }}>
                                              <div style={{ fontSize: "10px", color: t.muted, fontWeight: "600" }}>{s.label}</div>
                                              <div style={{ fontSize: "13px", fontWeight: "700", color: t.text }}>{s.value}</div>
                                            </div>
                                          ))}
                                        </div>

                                        {can(user.role, "canDeleteExpense") && (
                                          <button onClick={() => { if (window.confirm(`Delete "${mat.name}"?`)) deleteMaterial(mat.id, selectedProject.id); }}
                                            style={{ alignSelf: "flex-start", padding: "6px 14px", background: "rgba(239,68,68,0.07)", border: "1px solid rgba(239,68,68,0.2)", borderRadius: "8px", color: t.red, fontSize: "12px", fontWeight: "700", cursor: "pointer" }}>
                                            Delete Material
                                          </button>
                                        )}
                                      </div>
                                    )}
                                  </div>
                                );
                              })}
                            </div>
                          )}
                        </div>
                      );
                    })()}

                    {/* ══ ATTENDANCE TAB ══ */}
                    {projectTab === "attendance" && (() => {
                      const projectMembers = selectedProject.assigned_users || [];
                      const att = attendance[selectedProject.id] || [];
                      const todayStr = new Date().toISOString().split("T")[0];
                      const statusCol = { present: "#10b981", absent: "#ef4444", late: "#f59e0b", "half-day": "#3b82f6" };
                      const cardSt = { background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", padding: "22px", boxShadow: t.shadow };
