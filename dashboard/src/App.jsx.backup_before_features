                                        {icon}
                                      </button>
                                    ))}
                                  </div>
                                ))}
                              </div>
                              <textarea style={{ ...inputSt, height: "70px", resize: "vertical", marginBottom: "12px" }} placeholder="Additional notes..." value={safetyNote} onChange={e => setSafetyNote(e.target.value)} />
                              <div style={{ display: "flex", gap: "8px" }}>
                                <button onClick={() => setShowSafetyForm(false)} style={{ flex: 1, padding: "10px", background: t.hover, border: `1px solid ${t.divider}`, borderRadius: "9px", color: t.muted, fontWeight: "600", cursor: "pointer" }}>Cancel</button>
                                <button onClick={() => submitSafetyInspection(selectedProject.id)} style={{ flex: 2, padding: "10px", background: t.accent, border: "none", borderRadius: "9px", color: "#0f172a", fontWeight: "700", cursor: "pointer" }}>Submit Inspection</button>
                              </div>
                            </div>
                          )}

                          {/* inspection history */}
                          {inspections.length === 0 && !showSafetyForm ? (
