                                      </div>
                                    </div>
                                    ${exps.length > 0 ? `<div class="section"><h3>Expense Breakdown</h3>
                                      <table><thead><tr><th>#</th><th>Category</th><th>Description</th><th>Date</th><th>Added By</th><th>Amount</th></tr></thead><tbody>
                                      ${exps.map((e,i) => `<tr><td>${i+1}</td><td>${e.category}</td><td>${e.description||"—"}</td><td>${new Date(e.date).toLocaleDateString("en-IN")}</td><td>${e.added_by_name||"—"}</td><td><b>₹${Number(e.amount).toLocaleString()}</b></td></tr>`).join("")}
                                      <tr class="total-row"><td colspan="5" style="text-align:right;font-size:13px;">TOTAL EXPENSES</td><td><b>₹${totalSpent.toLocaleString()}</b></td></tr>
