                                  {[
                                    { label: "AI Progress Score", value: aiProgress + "%", note: "multi-signal blend" },
                                    { label: "Projected Final Cost", value: "₹" + (projectedFinalCost/1e7).toFixed(2) + "Cr", note: "at current burn rate" },
                                    { label: "AI Margin Forecast", value: projectedMarginAI.toFixed(1) + "%", note: trend + " vs booked margin", noteCol: trendCol },
                                  ].map((m,i) => (
                                    <div key={i} style={{ background: "rgba(255,255,255,0.05)", borderRadius: "10px", padding: "12px 14px" }}>
                                      <div style={{ fontSize: "10px", color: "#94a3b8", marginBottom: "5px" }}>{m.label}</div>
                                      <div style={{ fontSize: "16px", fontWeight: "800", color: "#f1f5f9" }}>{m.value}</div>
                                      <div style={{ fontSize: "10px", color: m.noteCol || "#64748b", marginTop: "3px" }}>{m.note}</div>
                                    </div>
                                  ))}
                                </div>
                                <div style={{ display: "grid", gridTemplateColumns: "repeat(4,1fr)", gap: "8px" }}>
                                  {[
                                    { label: "Tasks", score: Math.round(taskDone*100), weight: "35%" },
                                    { label: "Milestones", score: Math.round(mileDone*100), weight: "25%" },
                                    { label: "Site Logs", score: Math.round(logScore*100), weight: "20%" },
                                    { label: "Budget Health", score: Math.round(burnHealth*100), weight: "20%" },
                                  ].map((s,i) => {
                                    const sCol = s.score >= 70 ? "#22c55e" : s.score >= 40 ? "#f59e0b" : "#ef4444";
                                    return (
                                      <div key={i} style={{ background: "rgba(255,255,255,0.03)", borderRadius: "8px", padding: "8px 10px" }}>
                                        <div style={{ fontSize: "10px", color: "#94a3b8", marginBottom: "4px" }}>{s.label} <span style={{ color: "#475569" }}>({s.weight})</span></div>
                                        <div style={{ height: "4px", background: "rgba(255,255,255,0.08)", borderRadius: "99px", overflow: "hidden", marginBottom: "4px" }}>
                                          <div style={{ width: s.score + "%", height: "100%", background: sCol, borderRadius: "99px", transition: "width 0.8s ease" }} />
                                        </div>
                                        <div style={{ fontSize: "11px", fontWeight: "700", color: sCol }}>{s.score}%</div>
                                      </div>
                                    );
