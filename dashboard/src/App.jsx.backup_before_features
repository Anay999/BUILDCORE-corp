                  return (
                    <div key={a.id} style={{ background: t.card, borderRadius: "14px", border: `1px solid ${t.border}`, overflow: "hidden" }}>
                      <div style={{ padding: "18px 24px", borderBottom: `1px solid ${t.border}`, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                        <div style={{ display: "flex", alignItems: "center", gap: "12px" }}>
                          <div style={{ width: "9px", height: "9px", borderRadius: "50%", background: changeDetected ? "#10b981" : "#ef4444" }} />
                          <div>
                            <div style={{ fontSize: "14px", fontWeight: 700, color: t.text }}>Project #{a.project_id} — Site Upload Analysis</div>
                            <div style={{ fontSize: "11px", color: t.muted, marginTop: "2px" }}>{new Date(a.created_at || Date.now()).toLocaleString()} • {a.stage_detected}</div>
