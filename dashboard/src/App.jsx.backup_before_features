                      const col = statusColor(p.status);
                      return (
                        <div key={p.id} onClick={() => { setActivePage("projects"); setSelectedProject(p); fetchProgress(p.id); setProjectTab("overview"); fetchTasks(p.id); }}
                          style={{ display: "flex", alignItems: "center", gap: "8px", padding: "7px 14px", background: t.hover, borderRadius: "99px", border: `1px solid ${col}30`, cursor: "pointer", transition: "all 0.12s" }}
                          onMouseEnter={e => e.currentTarget.style.background = col + "18"}
                          onMouseLeave={e => e.currentTarget.style.background = t.hover}>
                          <div style={{ width: "8px", height: "8px", borderRadius: "50%", background: col, flexShrink: 0 }} />
                          <span style={{ fontSize: "12px", fontWeight: "600", color: t.text }}>{p.title}</span>
                          <span style={{ fontSize: "11px", color: t.muted }}>📍 {p.location}</span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          )}

          {/* ══════ ALERTS ══════ */}
          {activePage === "alerts" && (
            <div style={{ display: "flex", flexDirection: "column", gap: "10px" }}>

              {/* ── P&L Margin Alerts ── */}
              {can(user.role, "canViewPnL") && plCompany.filter(p => p.marginAlert).length > 0 && (
                <div style={{ display: "flex", flexDirection: "column", gap: "8px" }}>
                  <div style={{ fontSize: "11px", fontWeight: "700", color: t.muted, textTransform: "uppercase", letterSpacing: "0.09em", padding: "0 2px" }}>📊 Margin Alerts</div>
                  {plCompany.filter(p => p.marginAlert).map(p => (
                    <div key={`margin-${p.id}`} style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderLeft: "3px solid #ef4444", borderRadius: "14px", padding: "16px 20px", display: "flex", alignItems: "center", gap: "16px", boxShadow: t.shadow }}>
                      <div style={{ width: "40px", height: "40px", borderRadius: "10px", background: "rgba(239,68,68,0.1)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: "18px", flexShrink: 0 }}>📉</div>
                      <div style={{ flex: 1, minWidth: 0 }}>
                        <div style={{ display: "flex", alignItems: "center", gap: "8px", marginBottom: "4px" }}>
                          <span style={{ fontSize: "14px", fontWeight: "700", color: t.text }}>{p.title}</span>
                          <span style={{ fontSize: "10px", fontWeight: "700", padding: "2px 7px", borderRadius: "99px", background: "rgba(239,68,68,0.1)", color: "#ef4444", textTransform: "uppercase" }}>LOW MARGIN</span>
                        </div>
                        <div style={{ fontSize: "12px", color: t.muted }}>
                          Projected margin <strong style={{ color: "#ef4444" }}>{p.marginPct.toFixed(1)}%</strong> is below alert threshold of {p.alertThreshold}%. Gross profit: {fmtBudget(p.grossProfit)}.
                        </div>
                      </div>
                      <div style={{ textAlign: "right", flexShrink: 0 }}>
                        <div style={{ fontFamily: "'Barlow Condensed', sans-serif", fontSize: "28px", fontWeight: "800", color: "#ef4444", lineHeight: 1 }}>{p.marginPct.toFixed(1)}%</div>
                        <div style={{ fontSize: "10px", color: t.muted, marginTop: "2px" }}>margin</div>
                      </div>
                      <button onClick={() => { setActivePage("projects"); const proj = projects.find(pr => pr.id === p.id); if (proj) { setSelectedProject(proj); setProjectTab("pnl"); fetchPnL(proj.id); } }}
                        style={{ padding: "8px 14px", background: t.accentDim, border: `1px solid ${t.accent}30`, borderRadius: "8px", color: t.accent, fontSize: "12px", fontWeight: "600", cursor: "pointer", whiteSpace: "nowrap" }}>
                        View P&L →
                      </button>
                    </div>
                  ))}
                  <div style={{ height: "1px", background: t.divider, margin: "4px 0" }} />
                </div>
              )}

              {/* ── Deadline Alerts ── */}
              {alertProjects.length > 0 && <div style={{ fontSize: "11px", fontWeight: "700", color: t.muted, textTransform: "uppercase", letterSpacing: "0.09em", padding: "0 2px" }}>⏰ Deadline Alerts</div>}
              {alertProjects.length === 0 && plCompany.filter(p => p.marginAlert).length === 0 ? (
                <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", padding: "80px", textAlign: "center", boxShadow: t.shadow }}>
                  <div style={{ fontSize: "44px", marginBottom: "12px" }}>🎉</div>
                  <div style={{ fontSize: "16px", fontWeight: "600", color: t.text, marginBottom: "6px" }}>All Clear!</div>
                  <div style={{ fontSize: "13px", color: t.muted }}>No alerts to show.</div>
                </div>
              ) : [...alertProjects].sort((a, b) => new Date(a.deadline) - new Date(b.deadline)).map(p => {
                const dl = getDaysLeft(p.deadline);
                const col = dl < 0 ? t.red : dl <= 3 ? t.red : dl <= 7 ? "#f59e0b" : t.green;
                const urgency = dl < 0 ? "Overdue" : dl === 0 ? "Due Today" : dl <= 3 ? "Critical" : dl <= 7 ? "Upcoming" : "Scheduled";
                return (
                  <div key={p.id} style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderLeft: `3px solid ${col}`, borderRadius: "14px", padding: "18px 22px", display: "flex", alignItems: "center", gap: "18px", boxShadow: t.shadow }}>
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <div style={{ display: "flex", alignItems: "center", gap: "10px", flexWrap: "wrap", marginBottom: "5px" }}>
                        <span style={{ fontSize: "14px", fontWeight: "700", color: t.text }}>{p.title}</span>
                        <StatusBadge status={p.status} />
                        <span style={{ fontSize: "10px", fontWeight: "700", padding: "2px 7px", borderRadius: "99px", background: col + "18", color: col, textTransform: "uppercase", letterSpacing: "0.06em" }}>{urgency}</span>
                      </div>
                      <div style={{ fontSize: "12px", color: t.muted, marginBottom: "10px" }}>
                        📍 {p.location}{p.assigned_users?.length > 0 ? ` • 👥 ${p.assigned_users.map(u => u.name).join(", ")}` : ""}
                      </div>
                      <div style={{ height: "5px", background: t.hover, borderRadius: "99px", overflow: "hidden", border: `1px solid ${t.divider}`, maxWidth: "360px" }}>
                        <div style={{ width: dl < 0 ? "100%" : dl > 30 ? "5%" : `${100 - (dl / 30) * 100}%`, height: "100%", background: col, borderRadius: "99px" }} />
                      </div>
                    </div>
                    <div style={{ textAlign: "right", flexShrink: 0 }}>
                      <div style={{ fontFamily: "'Barlow Condensed', sans-serif", fontSize: "26px", fontWeight: "800", color: col, lineHeight: 1 }}>
                        {dl < 0 ? `+${Math.abs(dl)}d` : `${dl}d`}
                      </div>
                      <div style={{ fontSize: "11px", color: t.muted, marginTop: "3px" }}>
                        {new Date(p.deadline).toLocaleDateString("en-IN", { day: "2-digit", month: "short" })}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          )}

          {/* ══════ PURCHASES ══════ */}
          {activePage === "purchases" && can(user.role, "canRequestPO") && (() => {
            const sc = t.accent;
            const filtered = poFilter === "all" ? purchaseOrders : purchaseOrders.filter(p => p.status === poFilter);
            const statusColor = { draft: t.muted, pending: "#f59e0b", approved: "#10b981", received: "#6366f1", rejected: "#ef4444" };
            const statusIcon = { draft: "📝", pending: "⏳", approved: "✅", received: "📦", rejected: "❌" };
            const totalValue = purchaseOrders.reduce((a, p) => a + parseFloat(p.amount||0), 0);
            const pendingValue = purchaseOrders.filter(p => p.status === "pending").reduce((a, p) => a + parseFloat(p.amount||0), 0);
            const approvedValue = purchaseOrders.filter(p => p.status === "approved" || p.status === "received").reduce((a, p) => a + parseFloat(p.amount||0), 0);
            return (
              <div>
                <div style={{ fontSize: "20px", fontWeight: "800", color: t.text, marginBottom: "20px" }}>🛒 Purchase Orders</div>
                {/* KPI strip */}
                <div style={{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: "12px", marginBottom: "20px" }}>
                  {[
                    ["Total POs", purchaseOrders.length, sc],
                    ["Pending Approval", purchaseOrders.filter(p => p.status==="pending").length, "#f59e0b"],
                    ["Pending Value", "₹"+pendingValue.toLocaleString(), "#f59e0b"],
                    ["Approved Value", "₹"+approvedValue.toLocaleString(), "#10b981"],
                  ].map(([label, val, col]) => (
                    <div key={label} style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", padding: "16px 18px", boxShadow: t.shadow }}>
                      <div style={{ fontSize: "11px", color: t.muted, marginBottom: "4px" }}>{label}</div>
                      <div style={{ fontSize: "22px", fontWeight: "800", color: col }}>{val}</div>
                    </div>
                  ))}
                </div>
                {/* Create PO form */}
                <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", padding: "20px", marginBottom: "20px", boxShadow: t.shadow }}>
                  <div style={{ fontSize: "14px", fontWeight: "700", color: t.text, marginBottom: "14px" }}>+ Create New Purchase Order</div>
                  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: "10px", marginBottom: "10px" }}>
                    <div>
                      <div style={{ fontSize: "11px", color: t.muted, marginBottom: "4px" }}>Vendor Name *</div>
                      <input placeholder="Supplier..." value={poVendor} onChange={e => setPoVendor(e.target.value)}
                        style={{ width: "100%", padding: "8px 10px", borderRadius: "8px", border: `1px solid ${t.cardBorder}`, background: t.inputBg, color: t.text, fontSize: "13px" }} />
                    </div>
                    <div>
                      <div style={{ fontSize: "11px", color: t.muted, marginBottom: "4px" }}>Category</div>
                      <select value={poCategory} onChange={e => setPoCategory(e.target.value)}
                        style={{ width: "100%", padding: "8px 10px", borderRadius: "8px", border: `1px solid ${t.cardBorder}`, background: t.inputBg, color: t.text, fontSize: "13px" }}>
                        {["Materials","Equipment","Services","Subcontractor","Other"].map(c => <option key={c}>{c}</option>)}
                      </select>
                    </div>
                    <div>
                      <div style={{ fontSize: "11px", color: t.muted, marginBottom: "4px" }}>Project (optional)</div>
                      <select value={poProject} onChange={e => setPoProject(e.target.value)}
                        style={{ width: "100%", padding: "8px 10px", borderRadius: "8px", border: `1px solid ${t.cardBorder}`, background: t.inputBg, color: t.text, fontSize: "13px" }}>
                        <option value="">— Company-wide —</option>
                        {projects.map(p => <option key={p.id} value={p.id}>{p.title}</option>)}
                      </select>
                    </div>
                  </div>
                  <div style={{ marginBottom: "10px" }}>
                    <div style={{ fontSize: "11px", color: t.muted, marginBottom: "4px" }}>Description *</div>
                    <textarea rows={2} placeholder="What is being purchased..." value={poDesc} onChange={e => setPoDesc(e.target.value)}
                      style={{ width: "100%", padding: "8px 10px", borderRadius: "8px", border: `1px solid ${t.cardBorder}`, background: t.inputBg, color: t.text, fontSize: "13px", resize: "vertical" }} />
                  </div>
                  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: "10px", marginBottom: "14px" }}>
                    <div>
                      <div style={{ fontSize: "11px", color: t.muted, marginBottom: "4px" }}>Amount (₹) *</div>
                      <input type="number" placeholder="0" value={poAmount} onChange={e => setPoAmount(e.target.value)}
                        style={{ width: "100%", padding: "8px 10px", borderRadius: "8px", border: `1px solid ${t.cardBorder}`, background: t.inputBg, color: t.text, fontSize: "13px" }} />
                    </div>
                    <div>
                      <div style={{ fontSize: "11px", color: t.muted, marginBottom: "4px" }}>Expected Delivery</div>
                      <input type="date" value={poDate} onChange={e => setPoDate(e.target.value)}
                        style={{ width: "100%", padding: "8px 10px", borderRadius: "8px", border: `1px solid ${t.cardBorder}`, background: t.inputBg, color: t.text, fontSize: "13px" }} />
                    </div>
                    <div>
                      <div style={{ fontSize: "11px", color: t.muted, marginBottom: "4px" }}>Notes</div>
                      <input placeholder="Optional notes..." value={poNotes} onChange={e => setPoNotes(e.target.value)}
                        style={{ width: "100%", padding: "8px 10px", borderRadius: "8px", border: `1px solid ${t.cardBorder}`, background: t.inputBg, color: t.text, fontSize: "13px" }} />
                    </div>
                  </div>
                  <button onClick={() => createPO(null)}
                    style={{ padding: "9px 22px", background: sc, color: "#fff", border: "none", borderRadius: "8px", fontSize: "13px", fontWeight: "600", cursor: "pointer" }}>
                    Create PO
                  </button>
                </div>
                {/* Filter bar */}
                <div style={{ display: "flex", gap: "8px", marginBottom: "14px", flexWrap: "wrap" }}>
                  {["all","draft","pending","approved","received","rejected"].map(f => (
                    <button key={f} onClick={() => setPoFilter(f)}
                      style={{ padding: "6px 14px", borderRadius: "20px", border: `1px solid ${poFilter===f ? sc : t.cardBorder}`, background: poFilter===f ? sc : t.card, color: poFilter===f ? "#fff" : t.text, fontSize: "12px", fontWeight: "600", cursor: "pointer" }}>
                      {f === "all" ? `All (${purchaseOrders.length})` : `${f.charAt(0).toUpperCase()+f.slice(1)} (${purchaseOrders.filter(p=>p.status===f).length})`}
                    </button>
                  ))}
                  <button onClick={fetchPurchaseOrders}
                    style={{ marginLeft: "auto", padding: "6px 14px", borderRadius: "20px", border: `1px solid ${t.cardBorder}`, background: t.card, color: t.muted, fontSize: "12px", cursor: "pointer" }}>
                    ↻ Refresh
                  </button>
                </div>
                {/* PO Table */}
                <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", overflow: "hidden", boxShadow: t.shadow }}>
                  {filtered.length === 0 ? (
                    <div style={{ padding: "40px", textAlign: "center", color: t.muted, fontSize: "14px" }}>No purchase orders found.</div>
                  ) : (
                    <table style={{ width: "100%", borderCollapse: "collapse", fontSize: "13px" }}>
                      <thead>
                        <tr style={{ borderBottom: `1px solid ${t.cardBorder}`, background: t.bg }}>
                          {["PO #","Vendor","Project","Category","Amount","Status","Expected","Raised By","Actions"].map(h => (
                            <th key={h} style={{ padding: "10px 14px", textAlign: "left", fontSize: "11px", fontWeight: "700", color: t.muted, textTransform: "uppercase", letterSpacing: "0.05em" }}>{h}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {filtered.map((po, idx) => (
                          <tr key={po.id} style={{ borderBottom: `1px solid ${t.cardBorder}`, background: idx % 2 === 0 ? t.card : t.bg + "80" }}
                            onMouseEnter={e => e.currentTarget.style.background = t.hover}
                            onMouseLeave={e => e.currentTarget.style.background = idx % 2 === 0 ? t.card : t.bg + "80"}>
                            <td style={{ padding: "10px 14px", fontWeight: "700", color: sc }}>{po.po_number}</td>
                            <td style={{ padding: "10px 14px", color: t.text, fontWeight: "600" }}>{po.vendor_name}</td>
                            <td style={{ padding: "10px 14px", color: t.muted, fontSize: "12px" }}>{po.project_title || "—"}</td>
                            <td style={{ padding: "10px 14px" }}><span style={{ fontSize: "11px", background: t.cardBorder, color: t.muted, padding: "2px 8px", borderRadius: "6px" }}>{po.category}</span></td>
                            <td style={{ padding: "10px 14px", fontWeight: "700", color: t.text }}>₹{Number(po.amount).toLocaleString()}</td>
                            <td style={{ padding: "10px 14px" }}>
                              <span style={{ fontSize: "11px", fontWeight: "700", color: statusColor[po.status] }}>{statusIcon[po.status]} {po.status.toUpperCase()}</span>
                            </td>
                            <td style={{ padding: "10px 14px", color: t.muted, fontSize: "12px" }}>{po.expected_date ? po.expected_date.split("T")[0] : "—"}</td>
                            <td style={{ padding: "10px 14px", color: t.muted, fontSize: "12px" }}>{po.raised_by_name}</td>
                            <td style={{ padding: "10px 14px" }}>
                              <div style={{ display: "flex", gap: "6px" }}>
                                {po.status === "pending" && can(user.role, "canViewBudget") && (
                                  <>
                                    <button onClick={() => approvePO(po.id, null)}
                                      style={{ padding: "3px 10px", background: "#10b981", color: "#fff", border: "none", borderRadius: "5px", fontSize: "11px", fontWeight: "600", cursor: "pointer" }}>✓ Approve</button>
                                    <button onClick={() => rejectPO(po.id, null)}
                                      style={{ padding: "3px 10px", background: "#ef4444", color: "#fff", border: "none", borderRadius: "5px", fontSize: "11px", fontWeight: "600", cursor: "pointer" }}>✕ Reject</button>
                                  </>
                                )}
                                {po.status === "approved" && (
                                  <button onClick={() => receivePO(po.id, null)}
                                    style={{ padding: "3px 10px", background: "#6366f1", color: "#fff", border: "none", borderRadius: "5px", fontSize: "11px", fontWeight: "600", cursor: "pointer" }}>📦 Received</button>
                                )}
                                {po.status === "draft" && (
                                  <button onClick={() => axios.patch(`http://localhost:5000/api/purchase-orders/${po.id}/submit`, {}, { headers: headers() }).then(() => { fetchPurchaseOrders(); addToast("Submitted for approval", "success"); })}
                                    style={{ padding: "3px 10px", background: t.accent, color: "#0f172a", border: "none", borderRadius: "5px", fontSize: "11px", fontWeight: "700", cursor: "pointer" }}>Submit →</button>
                                )}
                                {(po.status === "draft" || po.status === "rejected") && (
                                  <button onClick={() => deletePO(po.id, null)}
                                    style={{ padding: "3px 8px", background: "none", border: `1px solid ${t.cardBorder}`, borderRadius: "5px", fontSize: "11px", color: "#ef4444", cursor: "pointer" }}>✕</button>
                                )}
                              </div>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  )}
                </div>
              </div>
            );
          })()}

          {/* ══════ CHAT ══════ */}
          {activePage === "chat" && (
            <div style={{ display: "flex", gap: 0, height: "calc(100vh - 130px)", background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "16px", overflow: "hidden", boxShadow: t.shadow }}>

              {/* ── LEFT: friends list ── */}
              <div style={{ width: "270px", flexShrink: 0, borderRight: `1px solid ${t.cardBorder}`, display: "flex", flexDirection: "column" }}>
                {/* header + search */}
                <div style={{ padding: "14px 14px 10px", borderBottom: `1px solid ${t.divider}` }}>
                  <div style={{ fontSize: "14px", fontWeight: "700", color: t.text, marginBottom: "10px" }}>Messages</div>
                  <div style={{ position: "relative" }}>
                    <div style={{ position: "absolute", left: "10px", top: "50%", transform: "translateY(-50%)", color: t.muted, pointerEvents: "none" }}><Ic.Search /></div>
                    <input
                      value={chatSearch}
                      onChange={e => setChatSearch(e.target.value)}
                      placeholder="Search..."
                      style={{ width: "100%", padding: "8px 10px 8px 32px", background: t.inputBg, border: `1px solid ${t.inputBorder}`, borderRadius: "9px", color: t.text, fontSize: "12px", outline: "none", boxSizing: "border-box" }}
                    />
                  </div>
                </div>
                {friends.length === 0 ? (
                  <div style={{ flex: 1, display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", padding: "30px 20px", textAlign: "center", color: t.muted }}>
                    <div style={{ fontSize: "32px", marginBottom: "10px" }}>💬</div>
                    <div style={{ fontSize: "13px", fontWeight: "600", color: t.text, marginBottom: "5px" }}>No connections yet</div>
                    <div style={{ fontSize: "11px" }}>Send a request from the Team page</div>
                  </div>
                ) : (
                  <div style={{ flex: 1, overflowY: "auto" }}>
                    {friends.filter(f => {
                      if (!chatSearch.trim()) return true;
                      const name = [f.first_name, f.last_name].filter(Boolean).join(" ") || f.name;
                      return name.toLowerCase().includes(chatSearch.toLowerCase());
                    }).map(f => {
                      const name = [f.first_name, f.last_name].filter(Boolean).join(" ") || f.name;
                      const col  = avatarColor(f.id);
                      const isActive = selectedChat?.id === f.id;
                      const fStatus = userStatuses[f.id] || "offline";
                      const statusCol = fStatus === "available" ? "#10b981" : fStatus === "working" ? "#ef4444" : "#6b7280";
                      return (
                        <div key={f.id} onClick={() => openChat(f)}
                          style={{ display: "flex", alignItems: "center", gap: "11px", padding: "11px 14px", cursor: "pointer", background: isActive ? t.accentDim : "transparent", borderLeft: isActive ? `3px solid ${t.accent}` : "3px solid transparent", transition: "background 0.12s" }}
                          onMouseEnter={e => { if (!isActive) e.currentTarget.style.background = t.hover; }}
                          onMouseLeave={e => { if (!isActive) e.currentTarget.style.background = "transparent"; }}
                        >
                          <div style={{ position: "relative", flexShrink: 0 }}>
                            {f.profile_picture
                              ? <img src={`http://localhost:5000/uploads/${f.profile_picture}`} alt={name} style={{ width: "40px", height: "40px", borderRadius: "50%", objectFit: "cover", border: `2px solid ${col}40` }} />
                              : <div style={{ width: "40px", height: "40px", borderRadius: "50%", background: col + "20", border: `2px solid ${col}40`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: "15px", fontWeight: "700", color: col }}>{(f.name || "?").charAt(0).toUpperCase()}</div>
                            }
                            <div style={{ position: "absolute", bottom: "1px", right: "1px", width: "10px", height: "10px", borderRadius: "50%", background: statusCol, border: `2px solid ${t.card}` }} />
                          </div>
                          <div style={{ flex: 1, minWidth: 0 }}>
                            <div style={{ fontSize: "13px", fontWeight: "600", color: t.text, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{name}</div>
                            <div style={{ fontSize: "11px", color: statusCol, fontWeight: "600", textTransform: "capitalize" }}>{fStatus}</div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>

              {/* ── RIGHT: chat window or landing ── */}
              {!selectedChat ? (
                <div style={{ flex: 1, display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", color: t.muted, gap: "14px" }}>
                  <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke={t.divider} strokeWidth="1.2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  <div>
                    <div style={{ fontSize: "16px", fontWeight: "700", color: t.text, textAlign: "center", marginBottom: "6px" }}>Your Messages</div>
                    <div style={{ fontSize: "13px", color: t.muted, textAlign: "center" }}>Looking for a chat? Select one on the left.</div>
                  </div>
                  {friends.length > 0 && (
                    <div style={{ display: "flex", gap: "8px", flexWrap: "wrap", justifyContent: "center", maxWidth: "300px" }}>
                      {friends.slice(0, 6).map(f => {
