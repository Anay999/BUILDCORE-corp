                                  <div key={i} style={{ background: "rgba(255,255,255,0.05)", borderRadius: "8px", padding: "10px 12px" }}>
                                    <div style={{ fontSize: "10px", color: "#94a3b8", marginBottom: "4px" }}>{m.label}</div>
                                    <div style={{ fontSize: "14px", fontWeight: "700", color: "#f1f5f9" }}>{m.value}</div>
                                  </div>
                                ))}
                              </div>
                              {latest.safety_findings && (
                                <div style={{ marginTop: "12px", padding: "10px 12px", background: "rgba(239,68,68,0.1)", borderRadius: "8px", border: "1px solid rgba(239,68,68,0.2)" }}>
                                  <div style={{ fontSize: "11px", color: "#fca5a5", fontWeight: "600" }}>⚠️ Safety Note</div>
                                  <div style={{ fontSize: "12px", color: "#fecaca", marginTop: "3px" }}>{latest.safety_findings}</div>
                                </div>
                              )}
                              <div style={{ marginTop: "12px", fontSize: "11px", color: "#64748b", textAlign: "right" }}>
                                Last analysed • <span style={{ cursor: "pointer", color: t.accent }} onClick={() => setProjectTab("snapshots")}>View all snapshots →</span>
                              </div>
                            </div>
                          );
                        })()}

                        {/* weather + activity chart row */}
                        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "12px" }}>
                          {/* weather card */}
                          <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "12px", padding: "16px 18px" }}>
                            <div style={{ fontSize: "10px", color: t.muted, fontWeight: "700", textTransform: "uppercase", letterSpacing: "0.08em", marginBottom: "10px" }}>Site Weather</div>
                            {weatherLoading ? (
                              <div style={{ fontSize: "12px", color: t.muted, padding: "16px 0" }}>⏳ Loading weather…</div>
                            ) : weather ? (
                              <div>
                                <div style={{ display: "flex", alignItems: "center", gap: "14px", marginBottom: "12px" }}>
                                  <div style={{ fontSize: "42px", lineHeight: 1 }}>{weather.icon}</div>
                                  <div>
                                    <div style={{ fontFamily: "'Barlow Condensed', sans-serif", fontSize: "34px", fontWeight: "800", color: t.text, lineHeight: 1 }}>{weather.temp}°C</div>
                                    <div style={{ fontSize: "12px", color: t.muted, marginTop: "2px" }}>{weather.desc}</div>
                                  </div>
                                </div>
                                <div style={{ display: "flex", gap: "14px", flexWrap: "wrap" }}>
                                  {[
                                    { icon: "🌧️", val: `${weather.rain}mm`, label: "Rain" },
                                    { icon: "💨", val: `${weather.wind} km/h`, label: "Wind" },
                                    { icon: "💧", val: `${weather.humidity}%`, label: "Humidity" },
                                    { icon: "🌡️", val: `${weather.feels}°C`, label: "Feels like" },
                                  ].map(({ icon, val, label }) => (
                                    <div key={label}>
                                      <div style={{ fontSize: "12px", fontWeight: "600", color: t.text }}>{icon} {val}</div>
                                      <div style={{ fontSize: "10px", color: t.muted }}>{label}</div>
                                    </div>
                                  ))}
                                </div>
                                <div style={{ fontSize: "11px", color: t.muted, marginTop: "8px" }}>📍 {weather.city}</div>
                              </div>
                            ) : (
                              <div style={{ fontSize: "12px", color: t.muted, padding: "8px 0" }}>Weather unavailable for this location.</div>
                            )}
                          </div>

                          {/* progress activity chart */}
                          <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "12px", padding: "16px 18px" }}>
                            <div style={{ fontSize: "10px", color: t.muted, fontWeight: "700", textTransform: "uppercase", letterSpacing: "0.08em", marginBottom: "10px" }}>Update Activity</div>
                            {(() => {
                              const updates = progressData[selectedProject.id] || [];
                              if (updates.length === 0) return <div style={{ fontSize: "12px", color: t.muted, padding: "8px 0" }}>No updates posted yet.</div>;
                              const counts = {};
                              updates.forEach(u => {
                                const d = new Date(u.created_at).toLocaleDateString("en-IN", { day: "2-digit", month: "short" });
                                counts[d] = (counts[d] || 0) + 1;
                              });
                              const chartData = Object.entries(counts).slice(-7).map(([date, count]) => ({ date, count }));
                              return (
                                <BarChart width={220} height={110} data={chartData} margin={{ top: 0, right: 0, left: -30, bottom: 0 }}>
                                  <XAxis dataKey="date" tick={{ fontSize: 9, fill: t.muted }} axisLine={false} tickLine={false} />
                                  <Bar dataKey="count" fill={t.accent} radius={[4, 4, 0, 0]} />
                                </BarChart>
                              );
                            })()}
                          </div>
                        </div>

                        {/* bottom row: team strip + recent activity */}
                        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "12px" }}>

                          {/* team avatars strip */}
                          <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "12px", padding: "16px 18px" }}>
                            <div style={{ fontSize: "10px", color: t.muted, fontWeight: "700", textTransform: "uppercase", letterSpacing: "0.08em", marginBottom: "12px" }}>Assigned Team</div>
                            {(selectedProject.assigned_users?.length || 0) === 0 ? (
                              <div style={{ fontSize: "12px", color: t.muted }}>No members assigned</div>
                            ) : (
                              <div style={{ display: "flex", flexDirection: "column", gap: "8px" }}>
                                {selectedProject.assigned_users.slice(0, 4).map(m => {
                                  const mc = avatarColor(m.id);
                                  const mSt = userStatuses[m.id] || "offline";
                                  const mStC = mSt === "available" ? "#10b981" : mSt === "working" ? "#ef4444" : "#6b7280";
                                  return (
                                    <div key={m.id} style={{ display: "flex", alignItems: "center", gap: "9px" }}>
                                      <div style={{ position: "relative", flexShrink: 0 }}>
                                        {m.profile_picture
                                          ? <div style={{ width: "28px", height: "28px", borderRadius: "8px", overflow: "hidden", border: `1.5px solid ${mc}40` }}><img src={`http://localhost:5000/uploads/${m.profile_picture}`} alt={m.name} style={{ width: "100%", height: "100%", objectFit: "cover" }} /></div>
                                          : <div style={{ width: "28px", height: "28px", borderRadius: "8px", background: mc + "20", border: `1.5px solid ${mc}40`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: "11px", fontWeight: "700", color: mc }}>{m.name.charAt(0).toUpperCase()}</div>
                                        }
                                        <div style={{ position: "absolute", bottom: "-2px", right: "-2px", width: "8px", height: "8px", borderRadius: "50%", background: mStC, border: `1.5px solid ${t.card}` }} />
                                      </div>
                                      <div>
                                        <div style={{ fontSize: "12px", fontWeight: "600", color: t.text }}>{m.name}</div>
                                        <div style={{ fontSize: "10px", color: t.muted, textTransform: "capitalize" }}>{mSt}</div>
                                      </div>
                                    </div>
                                  );
                                })}
                                {selectedProject.assigned_users.length > 4 && (
                                  <div style={{ fontSize: "11px", color: t.muted }}>+{selectedProject.assigned_users.length - 4} more</div>
                                )}
                              </div>
                            )}
                          </div>

                          {/* recent activity */}
                          <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "12px", padding: "16px 18px" }}>
                            <div style={{ fontSize: "10px", color: t.muted, fontWeight: "700", textTransform: "uppercase", letterSpacing: "0.08em", marginBottom: "12px" }}>Recent Activity</div>
                            {(() => {
                              const updates = (progressData[selectedProject.id] || []).slice(-3).reverse();
                              if (updates.length === 0) return <div style={{ fontSize: "12px", color: t.muted }}>No updates yet</div>;
                              return (
                                <div style={{ display: "flex", flexDirection: "column", gap: "10px" }}>
                                  {updates.map(u => (
                                    <div key={u.id} style={{ display: "flex", gap: "9px", alignItems: "flex-start" }}>
                                      <div style={{ width: "6px", height: "6px", borderRadius: "50%", background: t.accent, flexShrink: 0, marginTop: "5px" }} />
                                      <div style={{ minWidth: 0 }}>
                                        <div style={{ fontSize: "12px", color: t.text, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{u.note}</div>
                                        <div style={{ fontSize: "10px", color: t.muted, marginTop: "2px" }}>{u.uploader_name} · {fmtDateTime(u.created_at)}</div>
                                      </div>
                                    </div>
                                  ))}
                                </div>
                              );
                            })()}
                          </div>
                        </div>
                      </div>
                    )}

                    {/* ── TEAM TAB ── */}
                    {projectTab === "team" && (
                      <div style={{ display: "flex", flexDirection: "column", gap: "10px" }}>
                        <div style={{ fontSize: "11px", fontWeight: "700", color: t.muted, textTransform: "uppercase", letterSpacing: "0.08em", marginBottom: "4px" }}>
                          Assigned team — {selectedProject.assigned_users?.length || 0} member{(selectedProject.assigned_users?.length || 0) !== 1 ? "s" : ""}
                        </div>
                        {selectedProject.assigned_users?.length > 0 ? (
                          selectedProject.assigned_users.map(u => {
                            const col = avatarColor(u.id);
                            return (
                              <div key={u.id} style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "12px", padding: "14px 18px", display: "flex", alignItems: "center", gap: "14px" }}>
                                {(() => {
                                  const pStatus = userStatuses[u.id] || "offline";
                                  const pStatusCol = pStatus === "available" ? "#10b981" : pStatus === "working" ? "#ef4444" : "#6b7280";
                                  return (
                                    <div style={{ position: "relative", flexShrink: 0 }}>
                                      <div style={{ width: "44px", height: "44px", borderRadius: "11px", background: col + "20", border: `1.5px solid ${col}40`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: "17px", fontWeight: "700", color: col }}>
                                        {u.name.charAt(0).toUpperCase()}
                                      </div>
                                      <div style={{ position: "absolute", bottom: "-2px", right: "-2px", width: "11px", height: "11px", borderRadius: "50%", background: pStatusCol, border: `2px solid ${t.card}` }} title={pStatus} />
                                    </div>
                                  );
                                })()}
                                <div style={{ flex: 1 }}>
                                  <div style={{ fontSize: "14px", fontWeight: "600", color: t.text }}>{u.name}</div>
                                  <div style={{ fontSize: "11px", color: t.muted, textTransform: "capitalize", marginTop: "2px" }}>{roleLabel(u.role)}</div>
                                </div>
                              </div>
                            );
                          })
                        ) : (
                          <div style={{ background: t.card, border: `1px dashed ${t.cardBorder}`, borderRadius: "12px", padding: "50px", textAlign: "center" }}>
                            <div style={{ fontSize: "28px", marginBottom: "10px" }}>👥</div>
                            <div style={{ fontSize: "14px", color: t.muted }}>No team members assigned yet</div>
                            {user.role === "boss" && <div style={{ fontSize: "12px", color: t.muted, marginTop: "6px" }}>Use Edit Project to assign members</div>}
                          </div>
                        )}
                      </div>
                    )}

                    {/* ── PROGRESS TAB ── */}
                    {projectTab === "progress" && (() => {
                      const teamMembers = selectedProject.assigned_users || [];
                      const allUpdates  = progressData[selectedProject.id] || [];
                      const addFile = (file) => {
                        const isImg   = file.type.startsWith("image/");
                        const isVideo = file.type.startsWith("video/");
                        const preview = (isImg || isVideo) ? URL.createObjectURL(file) : null;
                        const kind    = isImg ? "image" : isVideo ? "video" : "doc";
                        setProgressFiles(prev => [...prev, { file, preview, type: kind, name: file.name }]);
                      };

                      // helper: render a list of update cards (used on both main feed + member page)
                      const renderUpdateCards = (updateList) => {
                        if (updateList.length === 0) return (
                          <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", padding: "60px 24px", textAlign: "center" }}>
                            <div style={{ fontSize: "40px", marginBottom: "12px" }}>📋</div>
                            <div style={{ fontSize: "15px", fontWeight: "600", color: t.text, marginBottom: "6px" }}>No updates yet</div>
                            <div style={{ fontSize: "13px", color: t.muted }}>No updates have been posted here.</div>
                          </div>
                        );
                        return (
                          <div style={{ display: "flex", flexDirection: "column", gap: "14px" }}>
                            {updateList.map((update, idx) => {
                              const uploaderUser = users.find(u => u.id === update.user_id);
                              const uploaderPic  = uploaderUser?.profile_picture ? `http://localhost:5000/uploads/${uploaderUser.profile_picture}` : null;
                              const uc = avatarColor(update.user_id || 0);
                              let attachments = [];
                              if (update.attachments) { try { attachments = JSON.parse(update.attachments); } catch { attachments = []; } }
                              else if (update.image) { attachments = [update.image]; }
                              return (
                                <div key={update.id} style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", overflow: "hidden", borderLeft: `3px solid ${uc}` }}>
                                  <div style={{ padding: "11px 16px", borderBottom: `1px solid ${t.divider}`, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                                    <div style={{ display: "flex", alignItems: "center", gap: "9px" }}>
                                      <div style={{ width: "22px", height: "22px", borderRadius: "50%", background: uc + "20", border: `1px solid ${uc}40`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: "10px", fontWeight: "800", color: uc, flexShrink: 0 }}>{updateList.length - idx}</div>
                                      {uploaderPic
                                        ? <div style={{ width: "28px", height: "28px", borderRadius: "50%", overflow: "hidden", border: `1.5px solid ${uc}50`, flexShrink: 0 }}><img src={uploaderPic} style={{ width: "100%", height: "100%", objectFit: "cover" }} /></div>
                                        : <div style={{ width: "28px", height: "28px", borderRadius: "50%", background: uc + "20", border: `1.5px solid ${uc}50`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: "11px", fontWeight: "700", color: uc, flexShrink: 0 }}>{(update.uploader_name || "?").charAt(0).toUpperCase()}</div>}
                                      <div>
                                        <div style={{ fontSize: "12px", fontWeight: "700", color: t.text }}>{update.uploader_name || "Unknown"}</div>
                                        <div style={{ fontSize: "10px", color: t.muted }}>{fmtDateTime(update.created_at)}</div>
                                      </div>
                                    </div>
                                    <div style={{ display: "flex", gap: "6px" }}>
                                      {update.user_id === user.id && editingProgressId !== update.id && (
                                        <button onClick={() => { setEditingProgressId(update.id); setEditProgressNote(update.note); }} title="Edit" style={{ background: t.accentDim, border: `1px solid ${t.accent}30`, borderRadius: "7px", color: t.accent, cursor: "pointer", padding: "5px 8px", display: "flex", alignItems: "center" }}><Ic.Edit /></button>
                                      )}
                                      {user.role === "boss" && (
                                        <button onClick={() => deleteProgress(update.id, selectedProject.id)} title="Delete" style={{ background: "rgba(239,68,68,0.08)", border: "1px solid rgba(239,68,68,0.2)", borderRadius: "7px", color: "#ef4444", cursor: "pointer", padding: "5px 8px", display: "flex", alignItems: "center" }}><Ic.Trash /></button>
                                      )}
                                    </div>
                                  </div>
                                  {attachments.length > 0 && editingProgressId !== update.id && (
                                    <div style={{ display: "grid", gridTemplateColumns: attachments.length === 1 ? "1fr" : "repeat(2, 1fr)", gap: "2px" }}>
                                      {attachments.map((fname, ai) => {
                                        const ext = fname.split(".").pop().toLowerCase();
                                        const isImg   = ["jpg","jpeg","png","gif","webp"].includes(ext);
                                        const isVideo = ["mp4","mov","webm","avi"].includes(ext);
                                        if (isImg) return <img key={ai} src={`http://localhost:5000/uploads/${fname}`} alt="" onClick={() => { setLightboxSrc(`http://localhost:5000/uploads/${fname}`); setLightboxZoom(1); }} style={{ width: "100%", height: attachments.length === 1 ? "220px" : "140px", objectFit: "cover", display: "block", cursor: "zoom-in" }} onError={e => e.target.style.display = "none"} />;
                                        if (isVideo) return <video key={ai} src={`http://localhost:5000/uploads/${fname}`} controls style={{ width: "100%", height: attachments.length === 1 ? "220px" : "140px", objectFit: "cover", display: "block", background: "#000" }} />;
                                        return <a key={ai} href={`http://localhost:5000/uploads/${fname}`} target="_blank" rel="noreferrer" style={{ display: "flex", alignItems: "center", gap: "9px", padding: "10px 14px", background: t.hover, textDecoration: "none", borderTop: `1px solid ${t.divider}` }}><Ic.FileDoc /><span style={{ fontSize: "12px", color: t.text, fontWeight: "500" }}>{fname}</span></a>;
                                      })}
                                    </div>
                                  )}
                                  {editingProgressId === update.id ? (
                                    <div style={{ padding: "14px 16px", display: "flex", flexDirection: "column", gap: "10px" }}>
                                      <textarea value={editProgressNote} onChange={e => setEditProgressNote(e.target.value)} style={{ ...inputSt, minHeight: "80px", resize: "vertical", lineHeight: "1.6", fontSize: "13px" }} />
                                      <div style={{ display: "flex", gap: "8px" }}>
                                        <button onClick={() => updateProgress(update.id, selectedProject.id)} style={{ flex: 1, padding: "8px", background: t.accent, border: "none", borderRadius: "8px", color: "#0f172a", fontWeight: "700", fontSize: "12px", cursor: "pointer" }}>Save</button>
                                        <button onClick={() => { setEditingProgressId(null); setEditProgressNote(""); }} style={{ flex: 1, padding: "8px", background: "transparent", border: `1px solid ${t.divider}`, borderRadius: "8px", color: t.muted, fontWeight: "600", fontSize: "12px", cursor: "pointer" }}>Cancel</button>
                                      </div>
                                    </div>
                                  ) : (
                                    <div style={{ padding: "14px 16px" }}>
                                      <p style={{ margin: 0, fontSize: "13px", color: t.text, lineHeight: "1.7" }}>{update.note}</p>
                                    </div>
                                  )}
                                </div>
                              );
                            })}
                          </div>
                        );
                      };

                      /* ── MEMBER PAGE (clicked a team card) ── */
                      if (selectedProgressEmployee) {
                        const emp = teamMembers.find(m => m.id === selectedProgressEmployee) || {};
                        const ec  = avatarColor(emp.id || 0);
                        const epic = emp.profile_picture ? `http://localhost:5000/uploads/${emp.profile_picture}` : null;
                        const memberUpdates = allUpdates.filter(u => u.user_id === emp.id);
                        return (
                          <div>
                            {/* back nav */}
                            <div style={{ display: "flex", alignItems: "center", gap: "16px", marginBottom: "22px" }}>
                              <button onClick={() => setSelectedProgressEmployee(null)}
                                style={{ display: "flex", alignItems: "center", gap: "7px", background: "transparent", border: `1px solid ${t.divider}`, borderRadius: "8px", color: t.muted, padding: "7px 14px", fontSize: "12px", fontWeight: "600", cursor: "pointer", transition: "all 0.15s" }}
                                onMouseEnter={e => { e.currentTarget.style.borderColor = t.accent; e.currentTarget.style.color = t.accent; }}
                                onMouseLeave={e => { e.currentTarget.style.borderColor = t.divider; e.currentTarget.style.color = t.muted; }}>
                                <Ic.ArrowL /> Back to Progress
                              </button>
                              {/* member identity */}
                              <div style={{ display: "flex", alignItems: "center", gap: "11px" }}>
                                <div style={{ width: "40px", height: "40px", borderRadius: "50%", overflow: "hidden", border: `2px solid ${ec}50`, flexShrink: 0 }}>
                                  {epic
                                    ? <img src={epic} style={{ width: "100%", height: "100%", objectFit: "cover" }} alt="" />
                                    : <div style={{ width: "100%", height: "100%", background: ec + "20", display: "flex", alignItems: "center", justifyContent: "center", fontSize: "16px", fontWeight: "700", color: ec }}>{(emp.first_name || emp.name || "?").charAt(0).toUpperCase()}</div>}
                                </div>
                                <div>
                                  <div style={{ fontSize: "16px", fontWeight: "800", color: t.text }}>{emp.first_name ? `${emp.first_name} ${emp.last_name || ""}`.trim() : emp.name}</div>
                                  <div style={{ fontSize: "11px", color: t.muted }}>{memberUpdates.length} update{memberUpdates.length !== 1 ? "s" : ""} on this project</div>
                                </div>
                              </div>
                            </div>
                            {renderUpdateCards(memberUpdates)}
                          </div>
                        );
                      }

                      /* ── MAIN PROGRESS VIEW ── */
                      return (
                        <div style={{ display: "flex", flexDirection: "column", gap: "16px" }}>

                            {/* POST UPDATE CARD — full rectangle */}
                            {user.role !== "client" && <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", overflow: "hidden" }}>
                              <div style={{ padding: "14px 20px", borderBottom: `1px solid ${t.divider}`, background: t.accentDim }}>
                                <span style={{ fontSize: "11px", fontWeight: "700", color: t.accent, textTransform: "uppercase", letterSpacing: "0.09em" }}>Post Update</span>
                              </div>
                              <div style={{ padding: "18px 20px", display: "flex", flexDirection: "column", gap: "14px" }}>
                                <textarea
                                  placeholder="What was completed today? Be specific…"
                                  value={progressNote}
                                  onChange={e => setProgressNote(e.target.value)}
                                  style={{ ...inputSt, minHeight: "150px", resize: "none", lineHeight: "1.75", fontSize: "13px", width: "100%", boxSizing: "border-box" }}
                                />
                                {/* attachment chips */}
                                {progressFiles.length > 0 && (
                                  <div style={{ display: "flex", flexWrap: "wrap", gap: "8px" }}>
                                    {progressFiles.map((f, i) => (
                                      <div key={i} style={{ position: "relative", borderRadius: "9px", overflow: "hidden", border: `1px solid ${t.divider}`, background: t.hover, flexShrink: 0 }}>
                                        {f.type === "image" && <img src={f.preview} alt="" style={{ width: "72px", height: "72px", objectFit: "cover", display: "block" }} />}
                                        {f.type === "video" && <video src={f.preview} style={{ width: "72px", height: "72px", objectFit: "cover", display: "block" }} muted />}
                                        {f.type === "doc" && (
                                          <div style={{ width: "72px", height: "72px", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", gap: "5px" }}>
                                            <Ic.FileDoc />
                                            <span style={{ fontSize: "9px", color: t.muted, textAlign: "center", padding: "0 4px", lineHeight: "1.2", wordBreak: "break-all" }}>{f.name.length > 12 ? f.name.slice(0,10)+"…" : f.name}</span>
                                          </div>
                                        )}
                                        <button onClick={() => setProgressFiles(prev => prev.filter((_, j) => j !== i))}
                                          style={{ position: "absolute", top: "3px", right: "3px", width: "18px", height: "18px", borderRadius: "50%", background: "rgba(0,0,0,0.7)", border: "none", color: "#fff", cursor: "pointer", fontSize: "10px", display: "flex", alignItems: "center", justifyContent: "center" }}>✕</button>
                                      </div>
                                    ))}
                                  </div>
                                )}
                                {/* hidden inputs */}
                                <input ref={progressPhotoRef} type="file" accept="image/*" multiple style={{ display: "none" }} onChange={e => { Array.from(e.target.files).forEach(addFile); e.target.value = ""; }} />
                                <input ref={progressVideoRef} type="file" accept="video/*" multiple style={{ display: "none" }} onChange={e => { Array.from(e.target.files).forEach(addFile); e.target.value = ""; }} />
                                <input ref={progressDocRef}   type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.csv,.zip" multiple style={{ display: "none" }} onChange={e => { Array.from(e.target.files).forEach(addFile); e.target.value = ""; }} />
                                {/* attach row */}
                                <div style={{ display: "flex", gap: "8px" }}>
                                  {[{ label: "Photo", icon: "🖼️", ref: progressPhotoRef }, { label: "Video", icon: "🎬", ref: progressVideoRef }, { label: "Document", icon: "📄", ref: progressDocRef }].map(btn => (
                                    <button key={btn.label} onClick={() => btn.ref.current?.click()}
                                      style={{ flex: 1, padding: "9px 6px", background: "transparent", border: `1.5px dashed ${t.divider}`, borderRadius: "9px", color: t.muted, fontSize: "11px", fontWeight: "600", cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", gap: "5px", transition: "all 0.15s" }}
                                      onMouseEnter={e => { e.currentTarget.style.borderColor = t.accent; e.currentTarget.style.color = t.accent; }}
                                      onMouseLeave={e => { e.currentTarget.style.borderColor = t.divider; e.currentTarget.style.color = t.muted; }}>
                                      <span>{btn.icon}</span>{btn.label}
                                    </button>
                                  ))}
                                </div>
                                <button onClick={() => addProgress(selectedProject.id)} disabled={!progressNote.trim()}
                                  style={{ padding: "12px", background: progressNote.trim() ? t.accent : t.hover, border: "none", borderRadius: "9px", color: progressNote.trim() ? "#0f172a" : t.muted, fontWeight: "700", fontSize: "13px", cursor: progressNote.trim() ? "pointer" : "not-allowed", transition: "all 0.15s" }}>
                                  Post Update
                                </button>
                              </div>
                            </div>

                            }
                            {/* YOUR PROGRESS — employee only */}
                            {user.role !== "boss" && (() => {
                              const myUpdates = allUpdates.filter(u => u.user_id === user.id);
                              return (
                                <div style={{ background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", overflow: "hidden" }}>
                                  <div style={{ padding: "12px 18px", borderBottom: `1px solid ${t.divider}`, display: "flex", alignItems: "center", justifyContent: "space-between" }}>
                                    <span style={{ fontSize: "11px", fontWeight: "700", color: t.muted, textTransform: "uppercase", letterSpacing: "0.07em" }}>Your Progress</span>
                                    {myUpdates.length > 0 && <span style={{ fontSize: "10px", color: t.muted }}>{myUpdates.length} update{myUpdates.length !== 1 ? "s" : ""}</span>}
                                  </div>
                                  {myUpdates.length === 0 ? (
                                    <div style={{ padding: "32px 20px", textAlign: "center" }}>
                                      <div style={{ fontSize: "28px", marginBottom: "8px" }}>📋</div>
                                      <div style={{ fontSize: "13px", fontWeight: "600", color: t.text, marginBottom: "4px" }}>No progress yet</div>
                                      <div style={{ fontSize: "11px", color: t.muted }}>Your updates will appear here after you post one.</div>
