                          { label: "Image / Photo",  Icon: Ic.Image,   color: t.blue,   accept: "image/*" },
                          { label: "Document / PDF", Icon: Ic.FileDoc, color: t.accent, accept: ".pdf,.doc,.docx,.txt" },
                          { label: "Video",          Icon: Ic.Film,    color: t.purple, accept: "video/*" },
