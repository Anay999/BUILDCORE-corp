/* ─── TOAST COMPONENT ───────────────────────────────────────── */
const ToastContainer = ({ toasts }) => {
  if (!toasts.length) return null;
  return (
    <div style={{ position: "fixed", bottom: "24px", right: "24px", zIndex: 9999, display: "flex", flexDirection: "column", gap: "10px", pointerEvents: "none" }}>
      {toasts.map(toast => {
        const colors = {
          success: { bg: "#10b981", icon: "✅" },
          error:   { bg: "#ef4444", icon: "❌" },
          info:    { bg: "#3b82f6", icon: "ℹ️" },
          warning: { bg: "#f59e0b", icon: "⚠️" },
        };
        const c = colors[toast.type] || colors.info;
        return (
          <div key={toast.id} style={{
            display: "flex", alignItems: "center", gap: "10px",
            padding: "12px 18px", borderRadius: "12px",
            background: "#0d1a2d", border: `1px solid ${c.bg}40`,
            boxShadow: `0 8px 32px rgba(0,0,0,0.4), 0 0 0 1px ${c.bg}20`,
            minWidth: "260px", maxWidth: "340px", pointerEvents: "all",
            animation: "toastIn 0.3s cubic-bezier(0.34,1.56,0.64,1)",
          }}>
            <div style={{ width: "32px", height: "32px", borderRadius: "8px", background: c.bg + "20", display: "flex", alignItems: "center", justifyContent: "center", fontSize: "14px", flexShrink: 0 }}>{c.icon}</div>
            <div style={{ flex: 1, minWidth: 0 }}>
              <div style={{ fontSize: "13px", fontWeight: "600", color: "#e8edf5", lineHeight: 1.4 }}>{toast.message}</div>
              {toast.sub && <div style={{ fontSize: "11px", color: "#5c7391", marginTop: "2px" }}>{toast.sub}</div>}
            </div>
            <div style={{ width: "3px", alignSelf: "stretch", borderRadius: "99px", background: c.bg, flexShrink: 0 }} />
          </div>
        );
      })}
    </div>
  );
};

