                        <Avatar name={m.name} size={32} id={m.id} src={m.profile_picture ? `http://localhost:5000/uploads/${m.profile_picture}` : null} />
                        <div style={{ flex: 1, minWidth: 0 }}>
                          <div style={{ fontSize: "13px", fontWeight: "600", color: t.text }}>{m.name}</div>
                          <div style={{ fontSize: "11px", color: t.muted }}>{m.email} · {m.role}</div>
                        </div>
                      </div>
