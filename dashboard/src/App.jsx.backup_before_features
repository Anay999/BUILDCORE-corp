                    <div style={{ flex: 1 }}>
                      <div style={{ fontSize: "14px", fontWeight: "700", color: t.text }}>{[selectedChat.first_name, selectedChat.last_name].filter(Boolean).join(" ") || selectedChat.name}</div>
                      {(() => { const s = userStatuses[selectedChat.id] || "offline"; const c = s === "available" ? "#10b981" : s === "working" ? "#ef4444" : "#6b7280"; return <div style={{ fontSize: "11px", color: c, fontWeight: "600", textTransform: "capitalize" }}>● {s}</div>; })()}
