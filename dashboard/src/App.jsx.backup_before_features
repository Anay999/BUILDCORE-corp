                                  <div style={{ display: "flex", alignItems: "center", gap: "10px" }}>
                                    <span style={{ fontSize: "11px", fontWeight: "700", padding: "3px 10px", borderRadius: "99px", background: col + "18", color: col, textTransform: "uppercase" }}>{insp.overall_status}</span>
                                    <span style={{ fontSize: "12px", color: t.muted }}>{passed}/{items.length} passed</span>
                                    {user.role === "boss" && (
                                      <button onClick={() => deleteSafety(insp.id, selectedProject.id)} style={{ padding: "4px 8px", background: "rgba(239,68,68,0.07)", border: "1px solid rgba(239,68,68,0.2)", borderRadius: "6px", color: t.red, fontSize: "11px", cursor: "pointer" }}>✕</button>
                                    )}
                                  </div>
                                </div>
                                <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(220px, 1fr))", gap: "6px" }}>
                                  {items.map((item, i) => (
                                    <div key={i} style={{ display: "flex", alignItems: "center", gap: "8px", fontSize: "12px", color: item.status === "pass" ? "#10b981" : item.status === "fail" ? "#ef4444" : t.muted }}>
                                      <span>{item.status === "pass" ? "✅" : item.status === "fail" ? "❌" : "➖"}</span>
                                      <span>{item.label}</span>
                                    </div>
                                  ))}
                                </div>
                                {insp.notes && <div style={{ marginTop: "10px", fontSize: "12px", color: t.muted, fontStyle: "italic" }}>Notes: {insp.notes}</div>}
                              </div>
                            );
                          })}
                        </div>
                      );
                    })()}

                    {/* ══ BUDGET TAB ══ */}
                    {projectTab === "budget" && (() => {
                      const exps = expenses[selectedProject.id] || [];
                      const totalBudget = Number(selectedProject.budget) || 0;
                      const totalSpent = exps.reduce((s, e) => s + Number(e.amount), 0);
                      const remaining = totalBudget - totalSpent;
                      const pctUsed = totalBudget > 0 ? Math.min(100, (totalSpent / totalBudget) * 100) : 0;
                      const budgetCol = pctUsed >= 90 ? "#ef4444" : pctUsed >= 70 ? "#f59e0b" : "#10b981";
                      const CATEGORIES = ["Materials","Labour","Equipment","Transport","Permits","Utilities","Misc"];
                      const byCategory = CATEGORIES.map(c => ({ name: c, amount: exps.filter(e => e.category === c).reduce((s, e) => s + Number(e.amount), 0) })).filter(c => c.amount > 0);
                      const cardSt = { background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", padding: "22px", boxShadow: t.shadow };
                      return (
                        <div style={{ display: "flex", flexDirection: "column", gap: "16px" }}>
                          {/* summary cards */}
                          <div style={{ display: "grid", gridTemplateColumns: "repeat(3,1fr)", gap: "12px" }}>
                            {[
                              { label: "Total Budget", value: fmtBudget(totalBudget), col: t.accent },
                              { label: "Total Spent", value: fmtBudget(totalSpent), col: budgetCol },
                              { label: "Remaining", value: fmtBudget(remaining), col: remaining >= 0 ? "#10b981" : "#ef4444" },
                            ].map((k, i) => (
                              <div key={i} style={{ ...cardSt, textAlign: "center", padding: "16px" }}>
                                <div style={{ fontSize: "11px", fontWeight: "700", color: t.muted, textTransform: "uppercase", marginBottom: "6px" }}>{k.label}</div>
                                <div style={{ fontSize: "24px", fontWeight: "800", color: k.col, fontFamily: "'Barlow Condensed', sans-serif" }}>{k.value}</div>
                              </div>
                            ))}
                          </div>

                          {/* budget bar */}
                          <div style={cardSt}>
                            <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "8px" }}>
                              <span style={{ fontSize: "13px", fontWeight: "600", color: t.text }}>Budget Utilisation</span>
                              <span style={{ fontSize: "13px", fontWeight: "700", color: budgetCol }}>{pctUsed.toFixed(1)}%</span>
                            </div>
                            <div style={{ height: "10px", background: t.hover, borderRadius: "99px", overflow: "hidden" }}>
                              <div style={{ width: pctUsed + "%", height: "100%", background: budgetCol, borderRadius: "99px", transition: "width 0.5s" }} />
                            </div>
                            {pctUsed >= 90 && <div style={{ fontSize: "12px", color: "#ef4444", marginTop: "8px", fontWeight: "600" }}>⚠️ Budget nearly exhausted!</div>}

                            {/* category breakdown */}
                            {byCategory.length > 0 && (
                              <div style={{ marginTop: "16px", display: "flex", flexDirection: "column", gap: "8px" }}>
                                {byCategory.map(c => (
                                  <div key={c.name}>
                                    <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "3px" }}>
                                      <span style={{ fontSize: "12px", color: t.muted }}>{c.name}</span>
                                      <span style={{ fontSize: "12px", fontWeight: "600", color: t.text }}>{fmtBudget(c.amount)}</span>
                                    </div>
                                    <div style={{ height: "4px", background: t.hover, borderRadius: "99px", overflow: "hidden" }}>
                                      <div style={{ width: totalSpent ? `${(c.amount/totalSpent)*100}%` : "0%", height: "100%", background: t.accent, borderRadius: "99px" }} />
                                    </div>
                                  </div>
                                ))}
                              </div>
                            )}
                          </div>

                          {/* add expense */}
                          <div style={cardSt}>
                            {can(user.role, "canAddExpense") && <div style={{ fontSize: "12px", fontWeight: "700", color: t.muted, textTransform: "uppercase", letterSpacing: "0.08em", marginBottom: "12px" }}>Log Expense</div>}
                            {can(user.role, "canAddExpense") && <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "10px", marginBottom: "10px" }}>
                              <select style={inputSt} value={expCategory} onChange={e => setExpCategory(e.target.value)}>
                                {CATEGORIES.map(c => <option key={c} value={c}>{c}</option>)}
                              </select>
                              <input type="number" style={inputSt} placeholder="Amount (₹)" value={expAmount} onChange={e => setExpAmount(e.target.value)} min="0" />
                              <input style={inputSt} placeholder="Description (optional)" value={expDesc} onChange={e => setExpDesc(e.target.value)} />
                              <input type="date" style={inputSt} value={expDate} onChange={e => setExpDate(e.target.value)} />
                            </div>}
                            {can(user.role, "canAddExpense") && <button onClick={() => addExpense(selectedProject.id)} disabled={!expAmount}
                              style={{ width: "100%", padding: "10px", background: expAmount ? t.accent : t.hover, border: "none", borderRadius: "9px", color: expAmount ? "#0f172a" : t.muted, fontWeight: "700", fontSize: "13px", cursor: expAmount ? "pointer" : "not-allowed" }}>
                              + Log Expense
                            </button>}
                          </div>

                          {/* expense list */}
                          {exps.length > 0 && (
                            <div style={cardSt}>
                              <div style={{ fontSize: "14px", fontWeight: "700", color: t.text, marginBottom: "14px" }}>Expense History</div>
                              <div style={{ display: "flex", flexDirection: "column", gap: "8px" }}>
                                {exps.map(e => (
                                  <div key={e.id} style={{ display: "flex", alignItems: "center", gap: "12px", padding: "10px 12px", background: t.hover, borderRadius: "9px" }}>
                                    <div style={{ width: "36px", height: "36px", borderRadius: "9px", background: t.accentDim, display: "flex", alignItems: "center", justifyContent: "center", fontSize: "14px", flexShrink: 0 }}>💸</div>
                                    <div style={{ flex: 1, minWidth: 0 }}>
                                      <div style={{ fontSize: "13px", fontWeight: "600", color: t.text }}>{e.category} {e.description ? `— ${e.description}` : ""}</div>
                                      <div style={{ fontSize: "11px", color: t.muted }}>{e.added_by_name} · {new Date(e.date).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}</div>
                                    </div>
                                    <div style={{ fontSize: "16px", fontWeight: "800", color: "#ef4444", fontFamily: "'Barlow Condensed', sans-serif" }}>-{fmtBudget(e.amount)}</div>
                                    {can(user.role, "canDeleteExpense") && (
                                      <button onClick={() => deleteExpense(e.id, selectedProject.id)} style={{ padding: "4px 8px", background: "rgba(239,68,68,0.07)", border: "1px solid rgba(239,68,68,0.2)", borderRadius: "6px", color: t.red, fontSize: "11px", cursor: "pointer" }}>✕</button>
                                    )}
                                  </div>
                                ))}
                              </div>
                            </div>
                          )}

                          {exps.length === 0 && (
                            <div style={{ ...cardSt, textAlign: "center", padding: "60px 40px" }}>
                              <div style={{ fontSize: "44px", marginBottom: "12px" }}>💰</div>
                              <div style={{ fontSize: "16px", fontWeight: "700", color: t.text, marginBottom: "6px" }}>No expenses logged</div>
                              <div style={{ fontSize: "13px", color: t.muted }}>Track every rupee spent on this project</div>
                            </div>
