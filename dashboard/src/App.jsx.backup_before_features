                            const contractVal = revenue.contractValue || 0;
                            const projectedFinalCost = spent > 0 && aiProgress > 5
                              ? (spent / (aiProgress / 100))
                              : costs.total;
                            const projectedProfit = contractVal - projectedFinalCost;
                            const projectedMarginAI = contractVal > 0 ? (projectedProfit / contractVal) * 100 : 0;

                            const riskLevel = projectedMarginAI >= 20 ? "Low Risk" : projectedMarginAI >= 8 ? "Moderate" : "High Risk";
