                                      .total-row{font-weight:700;background:#fffbeb;}
                                      .status-badge{display:inline-block;padding:3px 10px;border-radius:99px;font-size:10px;font-weight:700;text-transform:uppercase;background:#f59e0b20;color:#92400e;}
                                      .footer{margin-top:40px;padding-top:20px;border-top:1px solid #e2e8f0;text-align:center;color:#94a3b8;font-size:12px;}
                                      .big-total{text-align:right;margin-top:16px;font-size:24px;font-weight:900;color:#0f172a;}
                                      .big-total span{color:#f59e0b;}
                                    </style></head><body>
                                    <div class="header">
                                      <div><div class="logo">BUILD<span>CORE</span></div><p style="color:#64748b;margin-top:4px;font-size:12px;">Construction ERP</p></div>
                                      <div class="invoice-no"><h2>${invoiceNo}</h2><p>Date: ${new Date().toLocaleDateString("en-IN",{day:"numeric",month:"long",year:"numeric"})}</p><p>Status: <span class="status-badge">${selectedProject.status}</span></p></div>
                                    </div>
                                    <div class="section"><h3>Project Details</h3>
                                      <div class="info-grid">
                                        <div class="info-box"><div class="label">Project Name</div><div class="value">${selectedProject.title}</div></div>
                                        <div class="info-box"><div class="label">Client</div><div class="value">${selectedProject.client_name||"—"}</div></div>
                                        <div class="info-box"><div class="label">Location</div><div class="value">📍 ${selectedProject.location}</div></div>
                                        <div class="info-box"><div class="label">Deadline</div><div class="value">${selectedProject.deadline ? new Date(selectedProject.deadline).toLocaleDateString("en-IN",{day:"numeric",month:"long",year:"numeric"}) : "—"}</div></div>
                                      </div>
                                    </div>
                                    <div class="section"><h3>Budget Overview</h3>
                                      <div class="info-grid">
                                        <div class="info-box"><div class="label">Allocated Budget</div><div class="value">${fmtBudget(selectedProject.budget)}</div></div>
                                        <div class="info-box"><div class="label">Total Expenses</div><div class="value" style="color:#ef4444;">${fmtBudget(totalSpent)}</div></div>
