/* ─── HELPERS ────────────────────────────────────────────────── */
const statusColor = (s) => {
  const l = (s || "").toLowerCase();
  if (l === "completed") return "#10b981";
  if (l === "ongoing")   return "#3b82f6";
  if (l === "planned")   return "#8b5cf6";
  if (l === "delayed")   return "#ef4444";
  return "#f59e0b";
};

const progressPct = (status) => {
  const l = (status || "").toLowerCase();
  if (l === "completed") return 100;
  if (l === "ongoing")   return 55;
  if (l === "planned")   return 5;
  return 10;
};

const fmtBudget = (n) => {
  n = Number(n);
  if (n >= 10000000) return "₹" + (n / 10000000).toFixed(1) + "Cr";
  if (n >= 100000)   return "₹" + (n / 100000).toFixed(1) + "L";
  return "₹" + n.toLocaleString();
};


