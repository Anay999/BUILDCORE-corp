                                </div>
                              </div>
                              <div style={{ display: "grid", gridTemplateColumns: "repeat(3,1fr)", gap: "10px" }}>
                                {[
                                  { label: "AI Completion", value: latest.estimated_completion + "%" },
                                  { label: "Structural", value: latest.structural_integrity },
                                  { label: "Progress", value: latest.progress_change },
