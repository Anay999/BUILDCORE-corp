                        <div style={{ display: "flex", flexDirection: "column", gap: "16px" }}>
                          {/* date picker + stats */}
                          <div style={cardSt}>
                            <div style={{ display: "flex", alignItems: "center", gap: "14px", marginBottom: "16px" }}>
                              <label style={{ fontSize: "12px", fontWeight: "700", color: t.muted, textTransform: "uppercase" }}>Date</label>
                              <input type="date" value={attendanceDate} max={todayStr}
                                onChange={e => { setAttendanceDate(e.target.value); fetchAttendance(selectedProject.id, e.target.value); }}
                                style={{ ...inputSt, width: "160px" }} />
                              <div style={{ marginLeft: "auto", display: "flex", gap: "14px" }}>
                                {[["present","✅"],["absent","❌"],["late","⏰"],["half-day","🌗"]].map(([s, icon]) => (
                                  <div key={s} style={{ textAlign: "center" }}>
                                    <div style={{ fontSize: "16px" }}>{icon}</div>
                                    <div style={{ fontSize: "18px", fontWeight: "800", color: statusCol[s], fontFamily: "'Barlow Condensed', sans-serif" }}>{att.filter(a => a.status === s).length}</div>
                                    <div style={{ fontSize: "10px", color: t.muted, textTransform: "capitalize" }}>{s}</div>
                                  </div>
                                ))}
                              </div>
                            </div>

                            {projectMembers.length === 0 ? (
                              <p style={{ color: t.muted, fontSize: "13px" }}>No team members assigned to this project.</p>
                            ) : (
                              <div style={{ display: "flex", flexDirection: "column", gap: "8px" }}>
                                {projectMembers.map(member => {
                                  const record = att.find(a => String(a.user_id) === String(member.id));
                                  const status = record?.status || null;
                                  const col = status ? statusCol[status] : t.muted;
                                  return (
                                    <div key={member.id} style={{ display: "flex", alignItems: "center", gap: "12px", padding: "12px 14px", background: t.hover, borderRadius: "10px", border: `1px solid ${status ? col + "30" : t.divider}` }}>
                                      <Avatar name={member.name} size={34} id={member.id} />
                                      <div style={{ flex: 1 }}>
                                        <div style={{ fontSize: "13px", fontWeight: "600", color: t.text }}>{member.name}</div>
                                        <div style={{ fontSize: "11px", color: status ? col : t.muted, fontWeight: status ? "600" : "400", textTransform: "capitalize" }}>{status || "Not marked"}</div>
                                      </div>
                                      <div style={{ display: "flex", gap: "6px" }}>
                                        {[["present","✅"],["absent","❌"],["late","⏰"],["half-day","🌗"]].map(([s, icon]) => (
                                          <button key={s} onClick={() => markAttendance(selectedProject.id, member.id, s)}
                                            style={{ width: "32px", height: "32px", borderRadius: "8px", border: `1px solid ${status === s ? statusCol[s] : t.divider}`, background: status === s ? statusCol[s] + "18" : "transparent", cursor: "pointer", fontSize: "14px", display: "flex", alignItems: "center", justifyContent: "center", transition: "all 0.12s" }}>
                                            {icon}
                                          </button>
                                        ))}
                                      </div>
                                    </div>
                                  );
                                })}
                              </div>
                            )}
                          </div>
                        </div>
                      );
                    })()}

                    {/* ══ SAFETY TAB ══ */}
                    {projectTab === "safety" && (() => {
                      const inspections = safety[selectedProject.id] || [];
                      const DEFAULT_ITEMS = [
                        "Workers wearing PPE (helmets, vests, gloves)",
                        "Site perimeter secured",
                        "Fire extinguishers present",
                        "Scaffolding properly secured",
                        "Electrical hazards covered",
                        "First aid kit available",
                        "Emergency exits clear",
                        "Equipment in safe working condition",
                      ];
                      const overallCol = { pass: "#10b981", warning: "#f59e0b", fail: "#ef4444", pending: t.muted };
                      const cardSt = { background: t.card, border: `1px solid ${t.cardBorder}`, borderRadius: "14px", padding: "22px", boxShadow: t.shadow };
                      return (
                        <div style={{ display: "flex", flexDirection: "column", gap: "16px" }}>
                          {/* new inspection button */}
                          <div style={{ display: "flex", justifyContent: "flex-end" }}>
                            <button onClick={() => { setShowSafetyForm(true); setSafetyItems(DEFAULT_ITEMS.map(label => ({ label, status: "pending" }))); setSafetyNote(""); }}
                              style={{ display: "flex", alignItems: "center", gap: "7px", padding: "9px 18px", background: t.accent, border: "none", borderRadius: "9px", color: "#0f172a", fontWeight: "700", fontSize: "13px", cursor: "pointer" }}>
                              🛡️ New Inspection
                            </button>
                          </div>

                          {/* inspection form */}
                          {showSafetyForm && (
                            <div style={cardSt}>
                              <div style={{ fontSize: "14px", fontWeight: "700", color: t.text, marginBottom: "16px" }}>🛡️ Site Safety Inspection</div>
                              <div style={{ display: "flex", flexDirection: "column", gap: "8px", marginBottom: "14px" }}>
                                {safetyItems.map((item, i) => (
                                  <div key={i} style={{ display: "flex", alignItems: "center", gap: "12px", padding: "10px 14px", background: t.hover, borderRadius: "9px", border: `1px solid ${item.status === "pass" ? "#10b98130" : item.status === "fail" ? "#ef444430" : t.divider}` }}>
                                    <span style={{ flex: 1, fontSize: "13px", color: t.text }}>{item.label}</span>
                                    {[["pass","✅","#10b981"],["fail","❌","#ef4444"],["na","➖",t.muted]].map(([s, icon, c]) => (
