                                <div style={{ fontSize: "14px", fontWeight: "700", color: t.text }}>🧾 Invoice Generator</div>
                                <div style={{ fontSize: "12px", color: t.muted, marginTop: "2px" }}>Generate a professional invoice PDF for this project</div>
                              </div>
                              <button
                                onClick={() => {
                                  addToast("Generating invoice…", "info");
                                  setTimeout(() => {
