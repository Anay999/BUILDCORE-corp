                      </button>
                    </div>
                  </form>
                </div>
                {pendingAnalyses.length === 0 ? (
                  <div style={{ background: t.card, borderRadius: "14px", padding: "50px", textAlign: "center", border: `1px solid ${t.border}` }}>
                    <div style={{ fontSize: "32px", marginBottom: "10px" }}>✅</div>
                    <p style={{ color: t.text, fontWeight: 700, fontSize: "15px", margin: "0 0 6px" }}>All site uploads reviewed!</p>
                    <p style={{ color: t.muted, fontSize: "12px", margin: 0 }}>AI findings appear here when workers submit photos.</p>
                  </div>
                ) : pendingAnalyses.map(a => {
                  const bpComp = a.blueprint_comparison || {};
                  const schedStatus = bpComp.schedule_status || {};
                  const status = schedStatus.status || (a.delay_risk === "High" ? "BEHIND SCHEDULE" : "ON TRACK");
                  const sColor = status === "ON TRACK" || status === "AHEAD OF SCHEDULE" ? "#10b981" : status === "SLIGHTLY BEHIND" ? "#f59e0b" : "#ef4444";
